spec WTBSevenOriginalDefinitions = WTBFullFramedCoverageReturns
  and WTBConcreteMachineReturns and NRHodgeReturns and NRBSDReturns
  and NRNavierReturns and NRYangMillsReturns and NRPoincareReturns
  and NRRiemannReturns then
  preds WTBFullP, WTBFullRH, WTBFullHodge, WTBFullBSD,
        WTBFullYM, WTBFullNS, WTBFullPoincare,
        WTBSevenOriginal, WTBSevenWithRefinedBSD : ()
  preds WTBSevenFramed, WTBSevenRefinedFramed : FPStack
  . WTBFullP <=> WTBConcretePSource
  . WTBFullRH <=> (forall z : AFComplex .
      afNontrivialZetaZero(z) => afRe(z)=afHalf)
  . WTBFullHodge <=> AFRationalHodge
  . WTBFullBSD <=> AFClayBSD
  . WTBFullYM <=> FGeoYMExistsAndGap
  . WTBFullNS <=> FGeoNavierOriginal
  . WTBFullPoincare <=> (forall m : FGeoTopSpace .
      FGeoManifoldWithoutBoundary(m,fgThree) /\ FGeoHausdorff(m) /\
      FGeoSecondCountable(m) /\ FGeoCompact(m) /\ FGeoSimplyConnected(m) =>
        FGeoHomeomorphic(m,fgSphere(fgThree)))
  . WTBSevenOriginal <=> WTBFullP /\ WTBFullRH /\ WTBFullHodge /\
      WTBFullBSD /\ WTBFullYM /\ WTBFullNS /\ WTBFullPoincare
      %(WTB_exact_seven_original_positive_conjunction)%
  . WTBSevenWithRefinedBSD <=> WTBSevenOriginal /\ AFRefinedBSDQ
      %(WTB_refined_BSD_kept_in_addition_to_Clay_rank_goal)%
  forall w : FPStack
  . WTBSevenFramed(w) <=> WTBConcretePFramed(w) /\ WTBNRRiemannComplete(w) /\
      WTBNRHodgeComplete(w) /\ WTBNRBSDClayComplete(w) /\
      WTBNRYangMillsComplete(w) /\ WTBNRNavierResolved(w) /\
      WTBNRPoincareThreeComplete(w)
  . WTBSevenRefinedFramed(w) <=> WTBSevenFramed(w) /\ WTBNRBSDRefinedQComplete(w)
end


