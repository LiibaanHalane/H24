spec FGJointData = FGOperatorReturns then
  free type FGJoint ::= fgJoint(fgExecution:FCJointWitness;
      fgDifference:FGSum;fgNorm:EGInt)
  ops fgFromDifference : FCJointWitness * FGSum -> FGJoint;
      fgAssembleJoint : FCJointWitness -> FGJoint;
      fgConstructJoint : FCSafeCircuit * FTWord -> FGJoint
  pred FGJointValid : FGJoint
