%% SOURCE H23 BLOCK GoldbachSourceArithmetic line 4734
spec GoldbachSourceArithmetic =
  free type GBNat ::= gbZero | gbNext(GBNat)
  ops gbOne,gbTwo,gbThree,gbFour,gbFive,gbSeven : GBNat;
      gbPlus,gbTimes : GBNat * GBNat -> GBNat
  preds gbLt,gbLe,gbDivides,gbCoprime : GBNat * GBNat;
        gbPrime,gbOdd,gbEven : GBNat;
        gbCongruent : GBNat * GBNat * GBNat
  . gbOne = gbNext(gbZero)
  . gbTwo = gbNext(gbOne)
  . gbThree = gbNext(gbTwo)
  . gbFour = gbNext(gbThree)
  . gbFive = gbNext(gbFour)
  . gbSeven = gbNext(gbNext(gbFive))
  forall a,b,m : GBNat
  . gbPlus(gbZero,b) = b
  . gbPlus(gbNext(a),b) = gbNext(gbPlus(a,b))
  . gbTimes(gbZero,b) = gbZero
  . gbTimes(gbNext(a),b) = gbPlus(b,gbTimes(a,b))
  . gbLe(a,b) <=> (exists k : GBNat . gbPlus(a,k) = b)
  . gbLt(a,b) <=> gbLe(gbNext(a),b)
  . gbDivides(a,b) <=> (exists k : GBNat . gbTimes(a,k) = b)
  . gbCoprime(a,b) <=>
      (forall d : GBNat . gbDivides(d,a) /\ gbDivides(d,b) => d = gbOne)
  . gbPrime(a) <=>
      (gbLt(gbOne,a) /\ (forall d : GBNat .
         gbDivides(d,a) => d = gbOne \/ d = a))
  . gbEven(a) <=> (exists k : GBNat . a = gbTimes(gbTwo,k))
  . gbOdd(a) <=> (exists k : GBNat . a = gbNext(gbTimes(gbTwo,k)))
  . gbCongruent(a,b,m) <=> (exists k : GBNat .
      a = gbPlus(b,gbTimes(m,k)) \/ b = gbPlus(a,gbTimes(m,k)))
end


%% END EMITTED GoldbachSourceArithmetic

