%% SOURCE H23 BLOCK AYMThreeTimeReturns line 43487
spec AYMThreeTimeReturns = AYMThreeTimeData then
  forall s : AYMSystem; u : FGeoHilbertVector; e : FGeoReal
  . aymThree(s,u)=fgSub(fgMul(aymCeiling(s),aymWeight(s,u)),
      fgSub(aymC1(s,u),aymC2(s,u)))
      %(aym_three_time_triangle_is_the_exact_difference_Gram_residual)% %implied
