          nrRRunInput(r) = n /\ nrR30RunCheck(r) /\
          ftLe(ftPow(nrRRunTime(r),nrRTailAccuracy(p)),n)))
  forall m : FTPrizeMachine
  . nrR30Total(m) <=> ftValidMachine(m) /\
      (forall n : FTNat . exists p : NRR30Run .
        nrRRunMachine(p) = m /\ nrRRunInput(p) = n /\ nrR30RunCheck(p))
  . nrR30Sublinear(m) <=> nrR30Total(m) /\
      (forall k : FTNat . exists p : NRR30Tail . nrRTailMachine(p) = m /\
        nrRTailAccuracy(p) = k /\ nrR30SublinearTailCheck(p))
