spec MQProductData = MQSumData then
  sorts MQSectionX,MQSectionPull
  ops mqAtX : MQSectionX * HTX -> MQEvidence;
      mqAtPull : MQSectionPull * HTPullback -> MQEvidence;
      mqPiTo : HTYPrime * MQSectionX -> MQSectionPull;
      mqPiFrom : HTYPrime * MQSectionPull -> MQSectionX
  preds mqEqualX : HTYPrime * MQSectionX * MQSectionX;
        mqEqualPull : HTYPrime * MQSectionPull * MQSectionPull;
        mqAllPositiveX,mqAllOpposingX : HTYPrime * MQSectionX;
        mqAllPositivePull,mqAllOpposingPull : HTYPrime * MQSectionPull
  forall y : HTYPrime; x : HTX; z : HTPullback;
         s,t : MQSectionX; u,v : MQSectionPull
  . mqAtPull(mqPiTo(y,s),z)=mqAtX(s,htPullX(z))
  . mqAtX(mqPiFrom(y,u),x)=mqAtPull(u,htMakePullback(y,x))
  . mqEqualX(y,s,t) <=>
      (forall a : HTX . htQ(a)=htF(y) => mqAtX(s,a)=mqAtX(t,a))
  . mqEqualPull(y,u,v) <=>
      (forall a : HTPullback . htPullY(a)=y => mqAtPull(u,a)=mqAtPull(v,a))
  . mqAllPositiveX(y,s) <=>
      (forall a : HTX . htQ(a)=htF(y) => mqPositive(a,mqAtX(s,a)))
  . mqAllOpposingX(y,s) <=>
      (forall a : HTX . htQ(a)=htF(y) => mqOpposing(a,mqAtX(s,a)))
  . mqAllPositivePull(y,u) <=>
      (forall a : HTPullback . htPullY(a)=y => mqPositive(htPullX(a),mqAtPull(u,a)))
  . mqAllOpposingPull(y,u) <=>
      (forall a : HTPullback . htPullY(a)=y => mqOpposing(htPullX(a),mqAtPull(u,a)))
  %% Sections have only the two explicitly constructed reindexing
  %% operations. The equations do not choose an arbitrary family of
  %% witnesses from a pointwise existential assertion. Equality remains
  %% pointwise on the actual fibre, so off-fibre values are immaterial.
end


