%% SOURCE H23 BLOCK AFTateDefinitions line 5028
spec AFTateDefinitions = AFTateData then
  preds AFRationalTate, AFGeometricTate, AFGeneralizedTate : ()
  . AFRationalTate <=>
      (forall x : AFTModel; l : AFTPrime; r : AFNat; a : AFTClass .
        AFTSmoothProjective(x) /\ AFTPrimeAwayFromCharacteristic(aftField(x),l) /\
        AFTFixedClassAt(x,l,r,a) =>
        (exists z : AFTRationalCycle .
          AFTValidCycleAt(x,l,r,z) /\ aftCycleClass(x,l,r,z) = a))
      %(aft_base_field_rational_tate_definition)%
  . AFGeometricTate <=>
      (forall g : AFTGeometricVariety; l : AFTPrime; r : AFNat; a : AFTClass .
        (exists x : AFTModel .
          AFTSmoothProjective(x) /\ aftGeometric(x) = g /\
          AFTPrimeAwayFromCharacteristic(aftField(x),l) /\ AFTFixedClassAt(x,l,r,a))
        =>
        (exists y : AFTModel; z : AFTRationalCycle .
          AFTSmoothProjective(y) /\ aftGeometric(y) = g /\
          AFTPrimeAwayFromCharacteristic(aftField(y),l) /\
          AFTValidCycleAt(y,l,r,z) /\ aftCycleClass(y,l,r,z) = a))
      %(aft_geometric_eventual_fixed_tate_definition)%
  . AFGeneralizedTate <=>
      (forall x : AFTModel; l : AFTPrime; i,c : AFNat; v : AFTTateSubstructure .
        AFTSmoothProjective(x) /\ AFTPrimeAwayFromCharacteristic(aftField(x),l) /\
        AFTEffectiveTwistAt(x,l,i,c,v) =>
        (exists s : AFTSupport .
          AFTClosedSupportAtLeast(x,c,s) /\ AFTSubstructureSupportedOn(x,l,i,v,s)))
      %(aft_grothendieck_generalized_tate_definition)%
  %% The same-base support guard retains the original model. Passing
  %% through a finite extension and taking the finite union of the
  %% conjugate supports descends a geometric support without decreasing
  %% its codimension. This is the bridge to Milne's geometric form.
  %% Integral versions are separate. The AFI specifications below retain
  %% the full recovered positive CM-power family and the general negative
  %% endpoint. Neither changes these all-variety rational targets.
end


