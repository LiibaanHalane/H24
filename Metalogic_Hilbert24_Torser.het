spec HCFChargeReturns = HCFChargeData then
  forall a,b : Charge; p,q : HCProof
  . hcNoMore(a,b) <=> fgLE(hcfScore(a),hcfScore(b))
      %(hcf_the_selected_cost_valuation_preserves_and_reflects_original_proof_comparison)% %implied
  . hcfScore(a)=hcfScore(b) <=> a=b
      %(hcf_the_retained_order_reflection_does_not_erase_a_nonzero_proof_charge)% %implied
  . hcfScore(hcWork(p))=fgAdd(hcfScore(potential(hcConclusion(p))),hcfScore(hcExcess(p)))
      %(hcf_the_original_whole_proof_calibration_is_the_exact_energy_excess_decomposition)% %implied
  . hcConclusion(p)=hcConclusion(q) =>
      fgSub(hcfScore(hcWork(p)),hcfScore(hcWork(q)))=
        fgSub(hcfScore(hcExcess(p)),hcfScore(hcExcess(q)))
      %(hcf_comparing_same_goal_proofs_is_exactly_comparing_their_calibrated_excesses)% %implied
  . hcValid(p) /\ hcfScore(hcExcess(p))=fgZero => hcMinimum(p)
      %(hcf_a_zero_excess_energy_certificate_returns_the_minimum_over_all_original_admitted_proofs)% %implied
end

