spec HVIFibreData = HVIGibbsReturns then
  sort HVIMap
  ops hviProject : HVIMap * HVIPoint -> HVIPoint;
      hviIdentity : HVIMap;
      hviThen : HVIMap * HVIMap -> HVIMap;
      hviPull : HVIMap * HVIFamily -> HVIFamily;
      hviFibreSum : HVIAtoms * HVIMap * HVIFamily * HVIPoint -> FGeoReal;
      hviPush : HVIAtoms * HVIMap * HVIFamily -> HVIFamily;
      hviEffective : HVIAtoms * HVIMap * FGeoReal * HVIFamily * HVIFamily -> HVIFamily;
      hviGibbsLift : HVIAtoms * HVIMap * FGeoReal * HVIFamily * HVIFamily * HVIFamily -> HVIFamily
  preds HVIImage : HVIAtoms * HVIMap * HVIAtoms;
        HVIChart : HVIAtoms * HVIAtoms * HVIMap * HVIMap
  forall A,B : HVIAtoms; f,g : HVIMap; x,y : HVIPoint; beta : FGeoReal; mu,E,q : HVIFamily
  . hviProject(hviIdentity,x)=x
  . hviProject(hviThen(f,g),x)=hviProject(g,hviProject(f,x))
  . hviAt(hviPull(f,q),x)=hviAt(q,hviProject(f,x))
  . hviFibreSum(hviNil,f,q,y)=fgZero
  . hviProject(f,x)=y => hviFibreSum(hviCons(x,A),f,q,y)=
      fgAdd(hviAt(q,x),hviFibreSum(A,f,q,y))
  . not hviProject(f,x)=y => hviFibreSum(hviCons(x,A),f,q,y)=hviFibreSum(A,f,q,y)
  . hviAt(hviPush(A,f,q),y)=hviFibreSum(A,f,q,y)
  . HVIImage(A,f,B) <=> HVIDistinct(A) /\ HVIDistinct(B) /\
      (forall y : HVIPoint . HVIContains(B,y) <=>
        (exists x : HVIPoint . HVIContains(A,x) /\ hviProject(f,x)=y))
  . HVIChart(A,B,f,g) <=> HVIImage(A,f,B) /\ HVIImage(B,g,A) /\
      (forall x : HVIPoint . HVIContains(A,x) => hviProject(g,hviProject(f,x))=x) /\
      (forall y : HVIPoint . HVIContains(B,y) => hviProject(f,hviProject(g,y))=y)
  . hviAt(hviEffective(A,f,beta,mu,E),y)=aymNeg(fgDiv(hviLog(fgDiv(
      hviFibreSum(A,f,hviWeight(beta,mu,E),y),hviFibreSum(A,f,mu,y))),beta))
  . hviAt(hviGibbsLift(A,f,beta,mu,E,q),x)=fgDiv(
      fgMul(hviAt(q,hviProject(f,x)),hviAt(hviWeight(beta,mu,E),x)),
      hviFibreSum(A,f,hviWeight(beta,mu,E),hviProject(f,x)))
end


