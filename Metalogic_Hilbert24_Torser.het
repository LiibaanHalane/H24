  . gsuAct(a,x)=gsuVector4(
      gsuSum4(semRMul(semM11(a),gsuV1(x)),semRMul(semM12(a),gsuV2(x)),
        semRMul(semM13(a),gsuV3(x)),semRMul(semM14(a),gsuV4(x))),
      gsuSum4(semRMul(semM21(a),gsuV1(x)),semRMul(semM22(a),gsuV2(x)),
        semRMul(semM23(a),gsuV3(x)),semRMul(semM24(a),gsuV4(x))),
      gsuSum4(semRMul(semM31(a),gsuV1(x)),semRMul(semM32(a),gsuV2(x)),
        semRMul(semM33(a),gsuV3(x)),semRMul(semM34(a),gsuV4(x))),
      gsuSum4(semRMul(semM41(a),gsuV1(x)),semRMul(semM42(a),gsuV2(x)),
