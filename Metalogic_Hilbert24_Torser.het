%% SOURCE H23 BLOCK FCGeneralCompilerReturns line 32112
spec FCGeneralCompilerReturns = FCWireEnvironmentData then
  forall p : FCProgram; e : FCWireEnvironment; n : FTNat; x,v,z : FTWord
  . ftLength(fcAncillas(p))=fcWork(p) /\ ftLength(fcBuiltWork(p,v))=fcWork(p)
      %(fc_every_source_program_has_exact_initial_and_computed_work_allocation)% %implied
  . fcCount(fcCompile(p,e,n))=fcComputeCount(p)
      %(fc_syntax_directed_compiler_has_exact_primitive_fredkin_count)% %implied
  . fcWork(p)=ftAdd(ftMul(ftTwo,fcSize(p)),ftMul(fcThree,fcAndCount(p)))
      %(fc_actual_work_allocation_is_two_per_instruction_plus_three_per_and)% %implied
  . ftLe(fcComputeCount(p),ftMul(fcThree,fcSize(p))) /\
      ftLe(fcWork(p),ftMul(fcFive,fcSize(p)))
      %(fc_uniform_gate_and_workspace_bounds_for_every_source_program)% %implied
  . fcWellScoped(fcWireLength(e),p) /\ fcEnvironmentBelow(e,n) =>
      fcCodeWithin(fcCompile(p,e,n),ftAdd(n,fcWork(p))) /\
      ftLt(fcOutputWire(p,e,n),ftAdd(n,fcWork(p)))
      %(fc_every_compiled_gate_is_disjoint_and_in_the_allocated_source_register)% %implied
  . fcWellScoped(ftLength(v),p) /\ fcEnvironmentBelow(e,n) /\
      fcEnvironmentModels(e,x,v) /\ ftLength(x)=n =>
      fcRun(fcCompile(p,e,n),fcCat(x,fcCat(fcAncillas(p),z)))=
        fcCat(x,fcCat(fcBuiltWork(p,v),z))
      %(fc_complete_general_source_compiler_execution_with_every_spectator_retained)% %implied
  . fcWellScoped(ftLength(v),p) /\ fcEnvironmentBelow(e,n) /\
      fcEnvironmentModels(e,x,v) /\ ftLength(x)=n =>
      fcGet(fcCat(x,fcCat(fcBuiltWork(p,v),z)),fcOutputWire(p,e,n))=fcEval(p,v)
      %(fc_general_compiled_output_is_the_same_original_program_output)% %implied
  . fcEnvironmentModels(fcInputWires(ftLength(x),ftZero),fcDual(x),x) /\
      fcEnvironmentBelow(fcInputWires(ftLength(x),ftZero),ftMul(ftTwo,ftLength(x)))
      %(fc_actual_dual_input_constructs_its_full_source_wire_environment)% %implied
end


