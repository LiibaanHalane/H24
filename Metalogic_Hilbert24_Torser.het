    nrBTorsion : AFNat; nrBSha : AFNat; nrBRegulator : AFBReal;
    nrBVolume : AFBReal; nrBDiscriminant : AFBReal)
  preds nrBSDWeakCheck, nrBSDFullRankCheck : NRBSDRankPacket;
        nrBSDLeadingCheck : NRBSDLeadingPacket;
        NRBSDClayComplete, NRBSDRefinedQComplete,
        NRBSDNumberFieldRankComplete, NRBSDNumberFieldRefinedComplete : ()
  forall p : NRBSDRankPacket
  . nrBSDWeakCheck(p) <=>
      AFBIncompleteContinuationAt(nrBRankCurve(p),nrBRankFunction(p)) /\
      AFBRankAt(nrBRankCurve(p),nrBRank(p)) /\
      AFBTaylorLeadingTermAt(nrBRankFunction(p),nrBRank(p),nrBRankLeading(p))
  . nrBSDFullRankCheck(p) <=>
      AFBCompleteContinuationAt(nrBRankCurve(p),nrBRankFunction(p)) /\
      AFBRankAt(nrBRankCurve(p),nrBRank(p)) /\
      AFBTaylorLeadingTermAt(nrBRankFunction(p),nrBRank(p),nrBRankLeading(p))
  forall p : NRBSDLeadingPacket
  . nrBSDLeadingCheck(p) <=>
      AFBCompleteContinuationAt(nrBCurve(p),nrBFunction(p)) /\
      AFBRankAt(nrBCurve(p),nrBExactRank(p)) /\
      AFBTaylorLeadingTermAt(nrBFunction(p),nrBExactRank(p),nrBLeading(p)) /\
      AFBNonzeroInvariantDifferentialAt(nrBCurve(p),nrBDifferential(p)) /\
      AFBArithmeticTorsionCardinality(nrBCurve(p),nrBTorsion(p)) /\
      not nrBTorsion(p) = afZero /\ AFBShaFiniteCardinality(nrBCurve(p),nrBSha(p)) /\
      AFBRegulatorAt(nrBCurve(p),nrBRegulator(p)) /\
      AFBArchimedeanAndFiniteVolumeAt(nrBCurve(p),nrBDifferential(p),nrBVolume(p)) /\
      AFBPositiveDiscriminantRoot(afbField(nrBCurve(p)),nrBDiscriminant(p)) /\
      afbMultiply(afbMultiply(nrBLeading(p),afbEmbedNat(nrBTorsion(p))),
        afbMultiply(afbEmbedNat(nrBTorsion(p)),afbEmbedReal(nrBDiscriminant(p)))) =
      afbMultiply(afbEmbedNat(nrBSha(p)),
        afbMultiply(afbEmbedReal(nrBRegulator(p)),afbEmbedReal(nrBVolume(p))))
      %(nr_bsd_actual_leading_coefficient_all_quantities_check)%
  . NRBSDClayComplete <=> (forall e : AFBCurve . AFBClayIntegralModelOverQ(e) =>
      (exists p : NRBSDRankPacket . nrBRankCurve(p) = e /\ nrBSDWeakCheck(p)))
  . NRBSDRefinedQComplete <=> (forall e : AFBCurve . AFBClayIntegralModelOverQ(e) =>
      (exists p : NRBSDLeadingPacket . nrBCurve(p) = e /\ nrBSDLeadingCheck(p)))
  . NRBSDNumberFieldRankComplete <=> (forall e : AFBCurve .
      AFBEllipticCurve(e) /\ AFBNumberField(afbField(e)) =>
      (exists p : NRBSDRankPacket . nrBRankCurve(p) = e /\ nrBSDFullRankCheck(p)))
  . NRBSDNumberFieldRefinedComplete <=> (forall e : AFBCurve .
      AFBEllipticCurve(e) /\ AFBNumberField(afbField(e)) =>
      (exists p : NRBSDLeadingPacket . nrBCurve(p) = e /\ nrBSDLeadingCheck(p)))
end


