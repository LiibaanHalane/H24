%% SOURCE H23 BLOCK PAResidueData line 33971
spec PAResidueData = CNFGRefutationReturns then
  ops paTake,paDrop : FTNat * FTWord -> FTWord;
      paWordValue : FTWord -> FTNat;
      paModulus : FTNat -> FTNat;
      paResidue,paQuotient : FTNat * FTNat -> FTNat;
      paNegativeResidue : FTNat * FTNat -> FTNat;
      paSignedResidue : EGInt * FTNat -> FTNat
  preds PACongruent : FTNat * EGInt * EGInt;
        PAZeroResidue : FTNat * EGInt
  forall n,m : FTNat; b : FTBit; w : FTWord; z,t : EGInt
  . paTake(ftZero,w)=ftEmpty
  . paTake(ftSucc(m),ftEmpty)=ftEmpty
  . paTake(ftSucc(m),ftCons(b,w))=ftCons(b,paTake(m,w))
  . paDrop(ftZero,w)=w
  . paDrop(ftSucc(m),ftEmpty)=ftEmpty
  . paDrop(ftSucc(m),ftCons(b,w))=paDrop(m,w)
  . paWordValue(ftEmpty)=ftZero
  . paWordValue(ftCons(b,w))=ftAdd(ftBitValue(b),ftMul(ftTwo,paWordValue(w)))
  . paModulus(m)=ftPow(ftTwo,m)
  . paResidue(n,m)=paWordValue(paTake(m,ftBinaryLSB(n)))
  . paQuotient(n,m)=paWordValue(paDrop(m,ftBinaryLSB(n)))
  . paNegativeResidue(ftZero,m)=ftZero
  . ftLt(ftZero,n) => paNegativeResidue(n,m)=ftGap(paModulus(m),n)
  . paSignedResidue(egNonnegative(n),m)=paResidue(n,m)
  . paSignedResidue(egNegative(n),m)=paNegativeResidue(paResidue(ftSucc(n),m),m)
  . PACongruent(m,z,t) <=>
      (exists q : EGInt . z=egZAdd(t,egZMul(egNonnegative(paModulus(m)),q)))
  . PAZeroResidue(m,z) <=> paSignedResidue(z,m)=ftZero
end


