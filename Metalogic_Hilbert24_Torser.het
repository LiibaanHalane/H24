spec CJJointData = CJClockedReturns then
  free type CJJoint ::= cjJoint(cjProducer:FTPrizeMachine;
      cjCoefficient:FTNat;cjExponent:FTNat)
  ops cjPositiveMachine,cjNegativeMachine : CJJoint -> FTPrizeMachine;
      cjFromPositive,cjFromNegative : FTPrizeMachine * FTNat * FTNat -> CJJoint
  preds cjJointWitness : CJJoint * FTPrizeMachine * FTNat * FTNat
  forall j : CJJoint; m,v : FTPrizeMachine; c,d,b,e : FTNat
  . cjPositiveMachine(j)=cjProducer(j)
  . cjNegativeMachine(j)=cjMachine(cjProducer(j))
  . cjFromPositive(m,c,d)=cjJoint(m,c,d)
  . cjFromNegative(m,c,d)=cjJoint(cjMachine(m),c,d)
