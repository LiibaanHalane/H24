%% SOURCE H23 BLOCK FCStraightLineData line 32011
spec FCStraightLineData = FCIndexedGateReturns then
  free types FCUnary ::= fcCopy | fcNot;
             FCProgram ::= fcOutput(FTNat)
               | fcUnary(FCUnary;FTNat;FCProgram)
               | fcAnd(FTNat;FTNat;FCProgram)
               | fcConstant(FTBit;FCProgram);
             FCCircuit ::= fcCircuit(fcArity:FTNat;fcBody:FCProgram)
  ops fcUnaryValue : FCUnary * FTBit -> FTBit;
      fcEval : FCProgram * FTWord -> FTBit;
      fcSize,fcAndCount,fcWork,fcComputeCount : FCProgram -> FTNat;
      fcAncillas : FCProgram -> FTWord;
      fcBuiltWork : FCProgram * FTWord -> FTWord
  pred fcWellScoped : FTNat * FCProgram
  forall n,i,j : FTNat; p : FCProgram; u : FCUnary; b : FTBit; x : FTWord
  . fcUnaryValue(fcCopy,b)=b
  . fcUnaryValue(fcNot,b)=ftFlip(b)
  . fcWellScoped(n,fcOutput(i)) <=> ftLt(i,n)
  . fcWellScoped(n,fcUnary(u,i,p)) <=> ftLt(i,n) /\ fcWellScoped(ftSucc(n),p)
  . fcWellScoped(n,fcAnd(i,j,p)) <=> ftLt(i,n) /\ ftLt(j,n) /\ fcWellScoped(ftSucc(n),p)
  . fcWellScoped(n,fcConstant(b,p)) <=> fcWellScoped(ftSucc(n),p)
  . fcEval(fcOutput(i),x)=fcGet(x,i)
  . fcEval(fcUnary(u,i,p),x)=fcEval(p,ftCons(fcUnaryValue(u,fcGet(x,i)),x))
  . fcEval(fcAnd(i,j,p),x)=fcEval(p,ftCons(ftAnd(fcGet(x,i),fcGet(x,j)),x))
  . fcEval(fcConstant(b,p),x)=fcEval(p,ftCons(b,x))
  . fcSize(fcOutput(i))=ftZero
  . fcSize(fcUnary(u,i,p))=ftSucc(fcSize(p))
  . fcSize(fcAnd(i,j,p))=ftSucc(fcSize(p))
  . fcSize(fcConstant(b,p))=ftSucc(fcSize(p))
  . fcAndCount(fcOutput(i))=ftZero
  . fcAndCount(fcUnary(u,i,p))=fcAndCount(p)
  . fcAndCount(fcAnd(i,j,p))=ftSucc(fcAndCount(p))
  . fcAndCount(fcConstant(b,p))=fcAndCount(p)
  . fcWork(fcOutput(i))=ftZero
  . fcWork(fcUnary(u,i,p))=ftAdd(ftTwo,fcWork(p))
  . fcWork(fcAnd(i,j,p))=ftAdd(fcFive,fcWork(p))
  . fcWork(fcConstant(b,p))=ftAdd(ftTwo,fcWork(p))
  . fcComputeCount(fcOutput(i))=ftZero
  . fcComputeCount(fcUnary(u,i,p))=ftSucc(fcComputeCount(p))
  . fcComputeCount(fcAnd(i,j,p))=ftAdd(fcThree,fcComputeCount(p))
  . fcComputeCount(fcConstant(b,p))=fcComputeCount(p)
  . fcAncillas(fcOutput(i))=ftEmpty
  . fcAncillas(fcUnary(fcCopy,i,p))=ftCons(ftWhite,ftCons(ftBlack,fcAncillas(p)))
  . fcAncillas(fcUnary(fcNot,i,p))=ftCons(ftBlack,ftCons(ftWhite,fcAncillas(p)))
  . fcAncillas(fcAnd(i,j,p))=ftCons(ftWhite,ftCons(ftBlack,
      ftCons(ftWhite,ftCons(ftWhite,ftCons(ftBlack,fcAncillas(p))))))
  . fcAncillas(fcConstant(b,p))=ftCons(b,ftCons(ftFlip(b),fcAncillas(p)))
  . fcBuiltWork(fcOutput(i),x)=ftEmpty
  . fcBuiltWork(fcUnary(u,i,p),x)=
      ftCons(fcUnaryValue(u,fcGet(x,i)),ftCons(ftFlip(fcUnaryValue(u,fcGet(x,i))),
        fcBuiltWork(p,ftCons(fcUnaryValue(u,fcGet(x,i)),x))))
  . fcBuiltWork(fcAnd(i,j,p),x)=
      ftCons(ftAnd(fcGet(x,i),ftFlip(fcGet(x,j))),
        ftCons(ftFlip(fcGet(x,i)),ftCons(ftAnd(fcGet(x,i),fcGet(x,j)),
          ftCons(ftAnd(fcGet(x,i),fcGet(x,j)),ftCons(ftFlip(ftAnd(fcGet(x,i),fcGet(x,j))),
            fcBuiltWork(p,ftCons(ftAnd(fcGet(x,i),fcGet(x,j)),x)))))))
  . fcBuiltWork(fcConstant(b,p),x)=ftCons(b,ftCons(ftFlip(b),fcBuiltWork(p,ftCons(b,x))))
end


