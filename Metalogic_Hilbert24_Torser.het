  . gbSum(gbNil) = gbZero
  . gbAllOddPrime(gbNil)
  forall p : GBNat; l : GBList
  . gbLength(gbCons(p,l)) = gbNext(gbLength(l))
  . gbSum(gbCons(p,l)) = gbPlus(p,gbSum(l))
  . gbAllOddPrime(gbCons(p,l)) <=> gbPrime(p) /\ gbOdd(p) /\ gbAllOddPrime(l)
