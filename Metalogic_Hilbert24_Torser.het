%% SOURCE H23 BLOCK FTPackedRule30Source line 8391
spec FTPackedRule30Source = FTRule30Source then
  ops ftAnd : FTBit * FTBit -> FTBit;
      ftWest, ftEast, ftMaskedEast : FTNat -> FTBit;
      ftFour : FTNat;
      ftPairDigit : FTNat -> FTNat;
      ftPackedPrefix, ftSerialPrefix : FTNat * FTNat -> FTNat;
      ftSerialBit : FTNat * FTNat -> FTBit;
      ftCentreWindow : FTNat * FTNat -> FTWord
  preds ftCentrePeriod, ftMaskedPeriod, ftJointPeriod : FTNat * FTNat;
        ftFutureCentreSeparatesMask : FTNat * FTNat
  . ftFour = ftMul(ftTwo,ftTwo)
  forall a,b : FTBit; N,h,t,p,u : FTNat
  %% Redundant finite-generation law of the existing free FTBit datatype.
  %% CASL2TPTP_FOF otherwise replaces generation constraints by true.
  %% This preserves a source type law; it assumes no mathematical endpoint.
  . (a = ftWhite \/ a = ftBlack) %(tp_explicit_bit_generation_for_fof)%
  . ftAnd(ftWhite,a) = ftWhite
  . ftAnd(ftBlack,a) = a
  . ftWest(t) = ftCell(ftSingleton,t,ftLeft(ftOrigin))
  . ftEast(t) = ftCell(ftSingleton,t,ftRight(ftOrigin))
  . ftMaskedEast(t) = ftAnd(ftFlip(ftCentre(t)),ftEast(t))
  . ftPairDigit(t) = ftAdd(ftBitValue(ftCentre(t)),
                          ftMul(ftTwo,ftBitValue(ftMaskedEast(t))))
  . ftPackedPrefix(N,ftZero) = ftZero
  . ftPackedPrefix(N,ftSucc(h)) = ftAdd(ftPairDigit(N),
                          ftMul(ftFour,ftPackedPrefix(ftSucc(N),h)))
  . ftSerialBit(N,ftAdd(t,t)) = ftCentre(ftAdd(N,t))
  . ftSerialBit(N,ftSucc(ftAdd(t,t))) = ftMaskedEast(ftAdd(N,t))
  . ftSerialPrefix(N,ftZero) = ftZero
  . ftSerialPrefix(N,ftSucc(h)) = ftAdd(ftSerialPrefix(N,h),
                          ftMul(ftPow(ftTwo,h),ftBitValue(ftSerialBit(N,h))))
  . ftCentreWindow(t,ftZero) = ftEmpty
  . ftCentreWindow(t,ftSucc(h)) =
                          ftCons(ftCentre(t),ftCentreWindow(ftSucc(t),h))
  . ftCentrePeriod(N,p) <=>
       (forall h : FTNat . ftCentre(ftAdd(N,h)) = ftCentre(ftAdd(ftAdd(N,h),p)))
  . ftMaskedPeriod(N,p) <=>
       (forall h : FTNat . ftMaskedEast(ftAdd(N,h)) =
                          ftMaskedEast(ftAdd(ftAdd(N,h),p)))
  . ftJointPeriod(N,p) <=> ftCentrePeriod(N,p) /\ ftMaskedPeriod(N,p)
  . ftFutureCentreSeparatesMask(N,h) <=>
       (forall t,u : FTNat . ftLe(N,t) /\ ftLe(N,u) /\
        ftCentreWindow(t,ftSucc(h)) = ftCentreWindow(u,ftSucc(h)) =>
        ftMaskedEast(t) = ftMaskedEast(u))
end


