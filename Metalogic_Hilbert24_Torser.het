       FTPrizeState ::= ftRunning(FTNat; FTSite; FTPrizeTape) | ftFinished(FTBit)
  ops ftSymbolBound : FTNat -> FTNat;
      ftTableLength : FTPrizeTable -> FTNat;
      ftTableAt : FTPrizeTable * FTNat -> FTPrizeAction;
      ftTapeRead : FTPrizeTape * FTSite -> FTNat;
