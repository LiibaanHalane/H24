spec NRPoincarePackets = FGeoPoincareData then
  free etype NRPoincarePacket ::= nrPoincarePacket(
    nrPSource : FGeoTopSpace; nrPDimension : FGeoNat;
    nrPForward : FGeoContinuousMap; nrPBackward : FGeoContinuousMap)
  preds nrPoincareCheck, nrSmoothPoincareCheck : NRPoincarePacket;
        NRPoincareThreeComplete, NRPoincareTopologicalComplete,
        NRPoincareSmoothThreeComplete, NRPoincareSmoothFourComplete : ()
  forall p : NRPoincarePacket
  . nrPoincareCheck(p) <=> FGeoInverseMaps(nrPForward(p),nrPBackward(p),
      nrPSource(p),fgSphere(nrPDimension(p)))
  . nrSmoothPoincareCheck(p) <=> nrPoincareCheck(p) /\
      FGeoSmoothMap(nrPForward(p)) /\ FGeoSmoothMap(nrPBackward(p))
  . NRPoincareThreeComplete <=> (forall m : FGeoTopSpace .
      FGeoManifoldWithoutBoundary(m,fgThree) /\ FGeoHausdorff(m) /\
      FGeoSecondCountable(m) /\ FGeoCompact(m) /\ FGeoSimplyConnected(m) =>
      (exists p : NRPoincarePacket . nrPSource(p) = m /\
        nrPDimension(p) = fgThree /\ nrPoincareCheck(p)))
  . NRPoincareTopologicalComplete <=> (forall m : FGeoTopSpace; n : FGeoNat .
      FGeoManifoldWithoutBoundary(m,n) /\ FGeoHausdorff(m) /\
      FGeoSecondCountable(m) /\ FGeoCompact(m) /\
      FGeoHomotopyEquivalent(m,fgSphere(n)) =>
      (exists p : NRPoincarePacket . nrPSource(p) = m /\
        nrPDimension(p) = n /\ nrPoincareCheck(p)))
  . NRPoincareSmoothThreeComplete <=> (forall m : FGeoTopSpace .
      FGeoManifoldWithoutBoundary(m,fgThree) /\ FGeoSmoothManifold(m,fgThree) /\
      FGeoHausdorff(m) /\ FGeoSecondCountable(m) /\ FGeoCompact(m) /\
      FGeoSimplyConnected(m) =>
      (exists p : NRPoincarePacket . nrPSource(p) = m /\
        nrPDimension(p) = fgThree /\ nrSmoothPoincareCheck(p)))
  . NRPoincareSmoothFourComplete <=> (forall m : FGeoTopSpace .
      FGeoManifoldWithoutBoundary(m,fgFour) /\ FGeoSmoothManifold(m,fgFour) /\
      FGeoHausdorff(m) /\ FGeoSecondCountable(m) /\ FGeoCompact(m) /\
      FGeoHomotopyEquivalent(m,fgSphere(fgFour)) =>
      (exists p : NRPoincarePacket . nrPSource(p) = m /\
        nrPDimension(p) = fgFour /\ nrSmoothPoincareCheck(p)))
end


