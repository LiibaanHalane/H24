      hcfGoal : HCFPool -> Judgement;
      hcfReference,hcfCost,hcfExcess : HCFPool -> HVIFamily;
      hcfPotential : HCFPool -> FGeoReal
  preds HCFAdmitted : HCFPool;
        HCFTightPoint : HCFPool * HVIPoint
  forall P : HCFPool; x : HVIPoint
  . hcfPotential(P)=hcfScore(potential(hcfGoal(P)))
  . hviAt(hcfCost(P),x)=hcfScore(hcWork(hcfProof(P,x)))
  . hviAt(hcfExcess(P),x)=hcfScore(hcExcess(hcfProof(P,x)))
  . HCFAdmitted(P) <=> HVIReference(hcfCarrier(P),hcfReference(P)) /\
      (forall a : HVIPoint . HVIContains(hcfCarrier(P),a) =>
        hcValid(hcfProof(P,a)) /\ hcConclusion(hcfProof(P,a))=hcfGoal(P))
  . HCFTightPoint(P,x) <=> HCFAdmitted(P) /\ HVIContains(hcfCarrier(P),x) /\
      hcExcess(hcfProof(P,x))=zero
end


