spec FGFibreData = FGLinearReturns then
  ops fgI,fgJ,fgReturned : FCSafeCircuit * FTWord -> FTWord;
      fgDelta : FCSafeCircuit * FTWord -> FGSum;
      fgGram : FCSafeCircuit * FTWord * FTWord -> EGInt;
      fgReadInputs : FTNat * FTWord * FTNat -> FTWord;
      fgDecode : FCSafeCircuit * FTWord -> FTWord
  pred FGInitial : FCSafeCircuit * FTWord
  forall c : FCSafeCircuit; x,w : FTWord; n,i : FTNat
  . fgI(c,x)=fcPrepared(c,x,ftWhite,ftBlack)
  . fgJ(c,x)=fcPrepared(c,x,ftBlack,ftWhite)
  . fgReturned(c,x)=fcRun(fcOracle(c),fgI(c,x))
  . fgDelta(c,x)=fgSub(fgBasis(fgReturned(c,x)),fgBasis(fgI(c,x)))
  . fgReadInputs(ftZero,w,i)=ftEmpty
  . fgReadInputs(ftSucc(n),w,i)=ftCons(fcGet(w,i),fgReadInputs(n,w,ftAdd(i,ftTwo)))
  . fgDecode(c,w)=fgReadInputs(fcArity(c),w,ftZero)
  . FGInitial(c,w) <=> w=fgI(c,fgDecode(c,w))
  forall c : FCSafeCircuit; x,y : FTWord
  . fgGram(c,x,y)=fgInner(fgDelta(c,x),fgDelta(c,y))
end


