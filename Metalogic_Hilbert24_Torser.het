        AFBFFNormalizedHaarFamily : AFBFunctionFieldAbelian * AFBFFOpen * AFBFFHaarFamily;
        AFBFFTorsionOrder : AFBFunctionFieldAbelian * AFNat;
        AFBFFLogarithmicPairedRegulator : AFBFunctionFieldAbelian * AFBReal;
        AFBFFAdelicLieCovolume : AFBFunctionFieldAbelian * AFBFFHaarFamily * AFBReal;
        AFBFFOutsideGroupVolumeProduct : AFBFunctionFieldAbelian * AFBFFOpen * AFBFFHaarFamily * AFBReal;
        AFBFFOmittedEulerPolynomialProductAtOne : AFBFunctionFieldAbelian * AFBFFOpen * AFBComplex;
        AFBFFCompleteHasseWeilContinuation : AFBFunctionFieldAbelian * AFBFunction;
        AFBFFRationalPrime : AFBFFPrime;
        AFBFFFinitePrimaryShaOrder : AFBFunctionFieldAbelian * AFBFFPrime * AFNat

