%% SOURCE H23 BLOCK NRTatePackets line 18112
spec NRTatePackets = AFTateDefinitions then
  free etype NRTatePacket ::= nrTatePacket(
    nrTModel : AFTModel; nrTPrime : AFTPrime; nrTCodimension : AFNat;
    nrTQuestion : AFTClass; nrTCycle : AFTRationalCycle)
  free etype NRTateSupportPacket ::= nrTateSupportPacket(
    nrTSModel : AFTModel; nrTSPrime : AFTPrime; nrTSDegree : AFNat;
    nrTSConiveau : AFNat; nrTSStructure : AFTTateSubstructure; nrTSSupport : AFTSupport)
  preds nrTateCheck : NRTatePacket;
        nrTateSupportCheck : NRTateSupportPacket;
        NRTateComplete, NRGeneralizedTateComplete : ()
  forall p : NRTatePacket
  . nrTateCheck(p) <=>
      AFTValidCycleAt(nrTModel(p),nrTPrime(p),nrTCodimension(p),nrTCycle(p)) /\
      aftCycleClass(nrTModel(p),nrTPrime(p),nrTCodimension(p),nrTCycle(p)) = nrTQuestion(p)
      %(nr_tate_actual_marked_cycle_class_check)%
  forall p : NRTateSupportPacket
  . nrTateSupportCheck(p) <=>
      AFTClosedSupportAtLeast(nrTSModel(p),nrTSConiveau(p),nrTSSupport(p)) /\
      AFTSubstructureSupportedOn(nrTSModel(p),nrTSPrime(p),nrTSDegree(p),
        nrTSStructure(p),nrTSSupport(p))
      %(nr_tate_actual_support_check)%
  . NRTateComplete <=>
      (forall x : AFTModel; l : AFTPrime; r : AFNat; a : AFTClass .
        AFTSmoothProjective(x) /\ AFTPrimeAwayFromCharacteristic(aftField(x),l) /\
        AFTFixedClassAt(x,l,r,a) =>
        (exists p : NRTatePacket . nrTModel(p) = x /\ nrTPrime(p) = l /\
          nrTCodimension(p) = r /\ nrTQuestion(p) = a /\ nrTateCheck(p)))
      %(nr_tate_all_finite_fields_primes_degrees_classes)%
  . NRGeneralizedTateComplete <=>
      (forall x : AFTModel; l : AFTPrime; i,c : AFNat; v : AFTTateSubstructure .
        AFTSmoothProjective(x) /\ AFTPrimeAwayFromCharacteristic(aftField(x),l) /\
        AFTEffectiveTwistAt(x,l,i,c,v) =>
        (exists p : NRTateSupportPacket . nrTSModel(p) = x /\ nrTSPrime(p) = l /\
          nrTSDegree(p) = i /\ nrTSConiveau(p) = c /\ nrTSStructure(p) = v /\
          nrTateSupportCheck(p)))
      %(nr_tate_all_generalized_inputs)%
end


