%% SOURCE H23 BLOCK FTCoreNat line 4256
spec FTCoreNat =
  free type FTNat ::= ftZero | ftSucc(FTNat)
  ops ftAdd, ftMul, ftPow, ftGap : FTNat * FTNat -> FTNat;
      ftOne, ftTwo : FTNat
  preds ftLe, ftLt : FTNat * FTNat
  . ftOne = ftSucc(ftZero)
  . ftTwo = ftSucc(ftOne)
  forall a,b : FTNat
  . ftAdd(ftZero,b) = b
  . ftAdd(ftSucc(a),b) = ftSucc(ftAdd(a,b))
  . ftMul(ftZero,b) = ftZero
  . ftMul(ftSucc(a),b) = ftAdd(b,ftMul(a,b))
  . ftPow(a,ftZero) = ftOne
  . ftPow(a,ftSucc(b)) = ftMul(a,ftPow(a,b))
  . ftLe(ftZero,b)
  . not ftLe(ftSucc(a),ftZero)
  . ftLe(ftSucc(a),ftSucc(b)) <=> ftLe(a,b)
  . ftLt(a,b) <=> ftLe(ftSucc(a),b)
  . ftGap(ftZero,b) = b
  . ftGap(a,ftZero) = a
  . ftGap(ftSucc(a),ftSucc(b)) = ftGap(a,b)
end


%% END EMITTED FTCoreNat

%% SOURCE H23 BLOCK FTOriginalPositiveCollatz line 5974
spec FTOriginalPositiveCollatz = FTCoreNat then
  ops ftCollatz : FTNat -> FTNat;
      ftCollatzIter : FTNat * FTNat -> FTNat
  forall a,t,n : FTNat
  . ftCollatz(ftAdd(a,a)) = a
      %(ft_collatz_original_even_branch)%
  . ftCollatz(ftSucc(ftAdd(a,a))) = ftAdd(ftAdd(a,ftAdd(a,a)),ftTwo)
      %(ft_collatz_original_odd_branch)%
  . ftCollatzIter(ftZero,n) = n
      %(ft_collatz_original_iterate_zero)%
