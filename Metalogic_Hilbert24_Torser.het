  . not b=fgZero => fgMul(fgDiv(a,b),b)=a
  . not fgLT(a,a)
  . fgLT(a,b) /\ fgLT(b,c) => fgLT(a,c)
  . fgLT(a,b) \/ a=b \/ fgLT(b,a)
  . fgLT(a,b) => fgLT(fgAdd(a,c),fgAdd(b,c))
  . fgLT(fgZero,a) /\ fgLT(fgZero,b) => fgLT(fgZero,fgMul(a,b))
  . fgLT(fgZero,fgOne)
  . fgLE(a,b) <=> fgLT(a,b) \/ a=b
  . fgLE(fgZero,a) => aymAbs(a)=a
  . fgLT(a,fgZero) => aymAbs(a)=aymNeg(a)
  . aymTwo=fgAdd(fgOne,fgOne)
