%% SOURCE H23 BLOCK AFBSDPlaces line 5132
spec AFBSDPlaces = AFBSDAnalyticData then
  sorts AFBPlace; AFBDifferential
  free type AFBPlaceList ::= afbNoPlaces | afbTakePlace(AFBPlace; AFBPlaceList)
  ops afbRealOne : AFBReal;
      afbRealMultiply : AFBReal * AFBReal -> AFBReal;
      afbNatAsReal : AFNat -> AFBReal;
      afbComponentIndex : AFBCurve * AFBPlace -> AFNat;
      afbAbsoluteMinimalDifferentialRatio : AFBCurve * AFBDifferential * AFBPlace -> AFBReal;
      afbRealInvariantIntegral, afbComplexInvariantIntegral :
        AFBCurve * AFBDifferential * AFBPlace -> AFBReal;
      afbLocalVolume : AFBCurve * AFBDifferential * AFBPlace -> AFBReal;
      afbVolumeProduct : AFBCurve * AFBDifferential * AFBPlaceList -> AFBReal
  preds AFBNonzeroInvariantDifferentialAt : AFBCurve * AFBDifferential;
        AFBRealPlaceOf, AFBComplexPlaceOf, AFBFinitePlaceOf, AFBPlaceOf :
          AFBField * AFBPlace;
        AFBListedPlace : AFBPlaceList * AFBPlace;
        AFBDistinctPlacesOf : AFBField * AFBPlaceList;
        AFBArchimedeanAndFiniteVolumeAt : AFBCurve * AFBDifferential * AFBReal
  forall e : AFBCurve; k : AFBField; omega : AFBDifferential;
         v,w : AFBPlace; vs : AFBPlaceList; x : AFBReal
  . AFBPlaceOf(k,v) <=>
      AFBRealPlaceOf(k,v) \/ AFBComplexPlaceOf(k,v) \/ AFBFinitePlaceOf(k,v)
  . AFBRealPlaceOf(afbField(e),v) =>
      afbLocalVolume(e,omega,v) = afbRealInvariantIntegral(e,omega,v)
  . AFBComplexPlaceOf(afbField(e),v) =>
      afbLocalVolume(e,omega,v) = afbComplexInvariantIntegral(e,omega,v)
  . AFBFinitePlaceOf(afbField(e),v) =>
      afbLocalVolume(e,omega,v) =
        afbRealMultiply(afbNatAsReal(afbComponentIndex(e,v)),
                        afbAbsoluteMinimalDifferentialRatio(e,omega,v))
  . not AFBListedPlace(afbNoPlaces,v)
  . AFBListedPlace(afbTakePlace(w,vs),v) <=> (v = w \/ AFBListedPlace(vs,v))
  . AFBDistinctPlacesOf(k,afbNoPlaces)
  . AFBDistinctPlacesOf(k,afbTakePlace(v,vs)) <=>
      AFBPlaceOf(k,v) /\ AFBDistinctPlacesOf(k,vs) /\ not AFBListedPlace(vs,v)
  . afbVolumeProduct(e,omega,afbNoPlaces) = afbRealOne
  . afbVolumeProduct(e,omega,afbTakePlace(v,vs)) =
      afbRealMultiply(afbLocalVolume(e,omega,v),afbVolumeProduct(e,omega,vs))
  . AFBArchimedeanAndFiniteVolumeAt(e,omega,x) <=>
      (exists ps : AFBPlaceList .
        AFBDistinctPlacesOf(afbField(e),ps) /\ afbVolumeProduct(e,omega,ps) = x  /\ (forall p : AFBPlace .
          (AFBRealPlaceOf(afbField(e),p) \/ AFBComplexPlaceOf(afbField(e),p) \/
           (AFBFinitePlaceOf(afbField(e),p)  /\ not afbLocalVolume(e,omega,p) = afbRealOne)) => AFBListedPlace(ps,p)))
      %(afb_exact_product_of_local_volumes)%
end


