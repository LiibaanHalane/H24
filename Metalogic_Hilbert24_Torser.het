spec EGIntegerData = EGArithmetic then
  free type EGInt ::= egNonnegative(FTNat) | egNegative(FTNat)
  ops egZNeg : EGInt -> EGInt;
      egZAdd,egZMul : EGInt * EGInt -> EGInt;
      egZDifference : FTNat * FTNat -> EGInt
  forall a,b : FTNat
  . egZDifference(a,ftZero)=egNonnegative(a)
  . egZDifference(ftZero,ftSucc(b))=egNegative(b)
  . egZDifference(ftSucc(a),ftSucc(b))=egZDifference(a,b)
  . egZNeg(egNonnegative(ftZero))=egNonnegative(ftZero)
  . egZNeg(egNonnegative(ftSucc(a)))=egNegative(a)
  . egZNeg(egNegative(a))=egNonnegative(ftSucc(a))
  . egZAdd(egNonnegative(a),egNonnegative(b))=egNonnegative(ftAdd(a,b))
  . egZAdd(egNonnegative(a),egNegative(b))=egZDifference(a,ftSucc(b))
  . egZAdd(egNegative(a),egNonnegative(b))=egZDifference(b,ftSucc(a))
  . egZAdd(egNegative(a),egNegative(b))=egNegative(ftSucc(ftAdd(a,b)))
  . egZMul(egNonnegative(a),egNonnegative(b))=egNonnegative(ftMul(a,b))
  . egZMul(egNonnegative(a),egNegative(b))=egZNeg(egNonnegative(ftMul(a,ftSucc(b))))
  . egZMul(egNegative(a),egNonnegative(b))=egZNeg(egNonnegative(ftMul(ftSucc(a),b)))
  . egZMul(egNegative(a),egNegative(b))=egNonnegative(ftMul(ftSucc(a),ftSucc(b)))
end


