      gsuChartMatrix : GSUChart * SemSupportSix -> SemMatrix4;
      gsuChartRead : GSUChart * SemMatrix4 -> SemSupportSix;
      gsuChartVector,gsuChartVectorReturn : GSUChart * GSUVector4 -> GSUVector4;
      gsuChartGram,gsuChartGramInverse : GSUChart -> SemMatrix4;
      gsuAdjointAt : GSUChart * SemMatrix4 -> SemMatrix4;
      gsuChartOperator : GSUChart * SemMatrix4 -> SemMatrix4
  pred GSUChartValid : GSUChart
  forall p,q : GSUChart; x : SemSupportSix; a : SemMatrix4; v : GSUVector4
  . GSUChartValid(p) <=> GSUInverse(gsuBasis(p),gsuBasisInverse(p))
  . gsuChartInverse(p)=gsuChart(gsuBasisInverse(p),gsuBasis(p))
