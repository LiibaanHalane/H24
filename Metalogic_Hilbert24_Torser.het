%% SOURCE H23 BLOCK CJFredkinFibreData line 32651
spec CJFredkinFibreData = FCJointWitnessReturns then
  preds cjZeroSource,cjFixedFredkinFibre,cjNonzeroSource,cjFlippedFredkinFibre : FCSafeCircuit
  forall c : FCSafeCircuit
  . cjZeroSource(c) <=>
      (forall x : FTWord . ftLength(x)=fcArity(c) => fcEval(fcBody(c),x)=ftWhite)
  . cjFixedFredkinFibre(c) <=>
      (forall x : FTWord . ftLength(x)=fcArity(c) =>
        fcRun(fcOracle(c),fcPrepared(c,x,ftWhite,ftBlack))=
          fcPrepared(c,x,ftWhite,ftBlack))
  . cjNonzeroSource(c) <=>
      (exists x : FTWord . ftLength(x)=fcArity(c) /\ fcEval(fcBody(c),x)=ftBlack)
  . cjFlippedFredkinFibre(c) <=>
      (exists x : FTWord . ftLength(x)=fcArity(c) /\
        fcRun(fcOracle(c),fcPrepared(c,x,ftWhite,ftBlack))=
          fcPrepared(c,x,ftBlack,ftWhite))
end


