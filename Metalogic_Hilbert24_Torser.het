%% SOURCE H23 BLOCK FTCoreWords line 4279
spec FTCoreWords = FTCoreNat then
  free types FTBit ::= ftWhite | ftBlack;
             FTWord ::= ftEmpty | ftCons(FTBit; FTWord)
  ops ftXor, ftOr : FTBit * FTBit -> FTBit;
      ftFlip : FTBit -> FTBit;
      ftLength : FTWord -> FTNat;
      ftBinaryLSB : FTNat -> FTWord;
      ftBitValue : FTBit -> FTNat
  . ftFlip(ftWhite) = ftBlack
  . ftFlip(ftBlack) = ftWhite
  . ftBitValue(ftWhite) = ftZero
  . ftBitValue(ftBlack) = ftOne
  . ftLength(ftEmpty) = ftZero
  . ftBinaryLSB(ftZero) = ftEmpty
  forall e : FTBit; w : FTWord; a : FTNat
  . ftXor(ftWhite,e) = e
  . ftXor(ftBlack,e) = ftFlip(e)
  . ftOr(ftWhite,e) = e
  . ftOr(ftBlack,e) = ftBlack
  . ftLength(ftCons(e,w)) = ftSucc(ftLength(w))
  . ftBinaryLSB(ftSucc(ftAdd(a,a))) = ftCons(ftBlack,ftBinaryLSB(a))
  . not a = ftZero => ftBinaryLSB(ftAdd(a,a)) = ftCons(ftWhite,ftBinaryLSB(a))
end

