      cjClocked(cjPositiveMachine(j),cjCoefficient(j),cjExponent(j)) /\
      cjClocked(cjNegativeMachine(j),cjCoefficient(j),cjExponent(j)) /\
      gcDecidesVerifier(cjPositiveMachine(j),v,b,e) /\
      cjDecidesNegative(cjNegativeMachine(j),v,b,e)
end


