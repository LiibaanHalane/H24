  %% so this definition has no Artin holomorphy premise.
  . FANArtinHolomorphy <=>
      (forall r : FANArtin .
          FANIrreducibleFiniteImageArtin(r) /\ FANNontrivialArtin(r) =>
          FANArtinLIsEntire(r))
