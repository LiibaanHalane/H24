%% SOURCE H23 BLOCK AnalyticZetaData line 4616
spec AnalyticZetaData = AnalyticCriticalStripData then
  free type AFZetaNat ::= afZetaZero | afZetaNext(AFZetaNat)
  ops afZeta : AFComplex ->? AFComplex;
      afNegativeEven : AFZetaNat -> AFComplex;
      afCAdd : AFComplex * AFComplex -> AFComplex;
      afCNeg : AFComplex -> AFComplex
  %% afCAdd and afCNeg are complex addition and additive inverse.
  . afNegativeEven(afZetaZero) = afCNeg(afCAdd(afCOne,afCOne))
  forall n : AFZetaNat
  . afNegativeEven(afZetaNext(n)) = afCAdd(afNegativeEven(n),afNegativeEven(afZetaZero))
  pred afNontrivialZetaZero : AFComplex
  forall z : AFComplex
  . afNontrivialZetaZero(z) <=>
      (afZeta(z) = afCZero /\ not z = afCOne
       /\ not (exists n : AFZetaNat . z = afNegativeEven(n)))
      %(af_original_zeta_zero_definition)%
end


