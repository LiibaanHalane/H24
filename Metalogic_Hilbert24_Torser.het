  %% interpreted on a connected domain from its Euler half-plane to 1.
  %% At a bad place P_v is the usual inertia-invariant local polynomial.
  %% The complete function need not be entire on the whole s-plane.
  %% Covolume and volume product are finite and strictly positive.
  %% TorsionOrder and FiniteShaOrder mean exact group cardinalities.
  %% FinitePrimaryShaOrder(a,l,n) means #Sha(a)[l^infinity]=n;
  %% RationalPrime includes the characteristic prime of the base field.
end


