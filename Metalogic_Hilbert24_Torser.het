%% SOURCE H23 BLOCK FCCleanOracleData line 32141
spec FCCleanOracleData = FCGeneralCompilerReturns then
  ops fcCompute,fcOracle : FCSafeCircuit -> FCCode;
      fcOutputIndex,fcTargetIndex,fcGateBudget,fcWireBudget : FCSafeCircuit -> FTNat;
      fcPrepared : FCSafeCircuit * FTWord * FTBit * FTBit -> FTWord
  forall c : FCSafeCircuit; x : FTWord; y,z : FTBit
  . fcCompute(c)=fcCompile(fcBody(c),fcInputWires(fcArity(c),ftZero),ftMul(ftTwo,fcArity(c)))
  . fcOutputIndex(c)=fcOutputWire(fcBody(c),fcInputWires(fcArity(c),ftZero),ftMul(ftTwo,fcArity(c)))
  . fcTargetIndex(c)=ftAdd(ftMul(ftTwo,fcArity(c)),fcWork(fcBody(c)))
  . fcOracle(c)=fcJoin(fcCompute(c),fcJoin(
      fcNext(fcGate(fcOutputIndex(c),fcTargetIndex(c),ftSucc(fcTargetIndex(c))),fcNoGates),
      fcReverse(fcCompute(c))))
  . fcPrepared(c,x,y,z)=fcCat(fcDual(x),fcCat(fcAncillas(fcBody(c)),ftCons(y,ftCons(z,ftEmpty))))
  . fcGateBudget(c)=ftSucc(ftMul(ftTwo,fcComputeCount(fcBody(c))))
  . fcWireBudget(c)=ftAdd(fcTargetIndex(c),ftTwo)
end


