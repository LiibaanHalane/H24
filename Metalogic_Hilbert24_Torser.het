spec AFBSDDefinitions = AFBSDArithmeticData then
  preds AFClayBSD, AFRefinedBSDQ, AFNumberFieldBSDRank, AFNumberFieldBSDRefined : ()
  . AFClayBSD <=>
      (forall e : AFBCurve . AFBClayIntegralModelOverQ(e) =>
        (exists f : AFBFunction; r : AFNat; a : AFBComplex .
          AFBIncompleteContinuationAt(e,f) /\ AFBRankAt(e,r) /\
          AFBTaylorLeadingTermAt(f,r,a)))
      %(afb_clay_rank_definition)%
  . AFRefinedBSDQ <=>
      (forall e : AFBCurve . AFBClayIntegralModelOverQ(e) =>
        (exists f : AFBFunction; r : AFNat; a : AFBComplex .
          AFBCompleteContinuationAt(e,f) /\ AFBRankAt(e,r) /\
          AFBTaylorLeadingTermAt(f,r,a) /\ AFBLeadingCoefficientFormulaAt(e,a)))
      %(afb_refined_rational_bsd_definition)%
  . AFNumberFieldBSDRank <=>
      (forall e : AFBCurve . AFBEllipticCurve(e) /\ AFBNumberField(afbField(e)) =>
        (exists f : AFBFunction; r : AFNat; a : AFBComplex .
          AFBCompleteContinuationAt(e,f) /\ AFBRankAt(e,r) /\
          AFBTaylorLeadingTermAt(f,r,a)))
      %(afb_number_field_rank_definition)%
  . AFNumberFieldBSDRefined <=>
      (forall e : AFBCurve . AFBEllipticCurve(e) /\ AFBNumberField(afbField(e)) =>
        (exists f : AFBFunction; r : AFNat; a : AFBComplex .
          AFBCompleteContinuationAt(e,f) /\ AFBRankAt(e,r) /\
          AFBTaylorLeadingTermAt(f,r,a) /\ AFBLeadingCoefficientFormulaAt(e,a)))
      %(afb_number_field_refined_definition)%
end


