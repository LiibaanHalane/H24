%% SOURCE H23 BLOCK AFNaturalIndices line 4863
spec AFNaturalIndices =
  free type AFNat ::= afZero | afSucc(AFNat)
  ops afDouble : AFNat -> AFNat;
      afAdd : AFNat * AFNat -> AFNat
  pred afAtLeast : AFNat * AFNat
  forall n,k : AFNat
  . afAdd(afZero,k) = k
  . afAdd(afSucc(n),k) = afSucc(afAdd(n,k))
  . afDouble(afZero) = afZero
  . afDouble(afSucc(n)) = afSucc(afSucc(afDouble(n)))
  . afAtLeast(n,afZero)
  . not afAtLeast(afZero,afSucc(n))
  . afAtLeast(afSucc(n),afSucc(k)) <=> afAtLeast(n,k)
end

%% END EMITTED AFNaturalIndices

%% SOURCE H23 BLOCK AFBSDAnalyticData line 5078
spec AFBSDAnalyticData = AFNaturalIndices then
  sorts AFBField; AFBCurve; AFBFunction; AFBReal; AFBComplex
  ops afbField : AFBCurve -> AFBField;
      afbOne, afbZero : AFBComplex;
      afbEval : AFBFunction * AFBComplex -> AFBComplex;
      afbSubtract, afbMultiply : AFBComplex * AFBComplex -> AFBComplex;
      afbPower : AFBComplex * AFNat -> AFBComplex
  preds AFBNumberField : AFBField;
        AFBEllipticCurve : AFBCurve;
        AFBRationalField : AFBField;
        AFBIntegralShortWeierstrassModel, AFBNonzeroCubicDiscriminant : AFBCurve;
        AFBClayIntegralModelOverQ : AFBCurve;
        AFBRankAt : AFBCurve * AFNat;
        AFBEntire : AFBFunction;
        AFBRightOfThreeHalves : AFBComplex;
        AFBIncompleteEulerValue : AFBCurve * AFBComplex * AFBComplex;
        AFBCompleteEulerValue : AFBCurve * AFBComplex * AFBComplex;
        AFBAnalyticNearOne : AFBFunction;
        AFBAnalyticOnConnectedDomainFromEulerToOne : AFBFunction;
        AFBPositiveRadius : AFBReal;
        AFBWithinRadiusOfOne : AFBComplex * AFBReal;
        AFBIncompleteContinuationAt : AFBCurve * AFBFunction;
        AFBCompleteContinuationAt : AFBCurve * AFBFunction;
        AFBTaylorLeadingTermAt : AFBFunction * AFNat * AFBComplex
  forall e : AFBCurve; f : AFBFunction; r : AFNat; a : AFBComplex
  . AFBClayIntegralModelOverQ(e) <=>
      AFBEllipticCurve(e) /\ AFBRationalField(afbField(e))  /\ AFBIntegralShortWeierstrassModel(e) /\ AFBNonzeroCubicDiscriminant(e)
      %(afb_clay_original_curve_carrier)%
  %% For the Clay Taylor assertion, f is holomorphic on one
  %% connected domain containing the Euler half-plane and a
  %% neighbourhood of 1. This retains the original Taylor germ.
  . AFBIncompleteContinuationAt(e,f) <=>
      AFBAnalyticOnConnectedDomainFromEulerToOne(f) /\ (forall s : AFBComplex . AFBRightOfThreeHalves(s) =>
        AFBIncompleteEulerValue(e,s,afbEval(f,s)))
      %(afb_clay_incomplete_continuation)%
  . AFBCompleteContinuationAt(e,f) <=>
      AFBEntire(f) /\ (forall s : AFBComplex . AFBRightOfThreeHalves(s) =>
        AFBCompleteEulerValue(e,s,afbEval(f,s)))
      %(afb_complete_continuation)%
  . AFBTaylorLeadingTermAt(f,r,a) <=>
      not a = afbZero /\
      (exists g : AFBFunction; epsilon : AFBReal .
        AFBAnalyticNearOne(g) /\ AFBPositiveRadius(epsilon) /\ afbEval(g,afbOne) = a /\
        (forall s : AFBComplex . AFBWithinRadiusOfOne(s,epsilon) =>
          afbEval(f,s) = afbMultiply(afbPower(afbSubtract(s,afbOne),r),afbEval(g,s))))
      %(afb_exact_nonzero_taylor_factor)%
  %% Each EulerValue relation means convergence of the specified
  %% ordered Euler product to the supplied value. In the incomplete
  %% source good factors are (1-a_p p^(-s)+p^(1-2s))^(-1) with the
  %% original integral model's a_p=p-N_p, with p not dividing 2*Delta.
  %% The complete source uses
  %% every correct good or bad local factor and residue field size.
end


