spec AQ26TUltrametricData =
  sorts AQ26TVector, AQ26TRadius
  ops aq26tZero : AQ26TVector;
      aq26tAdd : AQ26TVector * AQ26TVector -> AQ26TVector;
      aq26tNeg : AQ26TVector -> AQ26TVector;
      aq26tSub : AQ26TVector * AQ26TVector -> AQ26TVector;
      aq26tZeroRadius : AQ26TRadius;
      aq26tMax : AQ26TRadius * AQ26TRadius -> AQ26TRadius;
      aq26tNorm : AQ26TVector -> AQ26TRadius;
      aq26tDist : AQ26TVector * AQ26TVector -> AQ26TRadius
  preds aq26tLe, aq26tLt : AQ26TRadius * AQ26TRadius
  pred aq26tBall : AQ26TVector * AQ26TVector * AQ26TRadius

  forall u,v,w : AQ26TVector
  . aq26tAdd(aq26tAdd(u,v),w)=aq26tAdd(u,aq26tAdd(v,w))
  . aq26tAdd(u,v)=aq26tAdd(v,u)
  . aq26tAdd(aq26tZero,u)=u
  . aq26tAdd(u,aq26tNeg(u))=aq26tZero
  . aq26tSub(u,v)=aq26tAdd(u,aq26tNeg(v))

  forall r,s,t : AQ26TRadius
  . aq26tLe(r,r)
  . aq26tLe(r,s) /\ aq26tLe(s,r) => r=s
  . aq26tLe(r,s) /\ aq26tLe(s,t) => aq26tLe(r,t)
  . aq26tLe(r,s) \/ aq26tLe(s,r)
  . aq26tLe(aq26tZeroRadius,r)
  . aq26tLt(r,s) <=> aq26tLe(r,s) /\ not (r=s)
  . aq26tLe(r,s) => aq26tMax(r,s)=s
  . not aq26tLe(r,s) => aq26tMax(r,s)=r

  forall u,v : AQ26TVector; r : AQ26TRadius
  . aq26tNorm(u)=aq26tZeroRadius <=> u=aq26tZero
  . aq26tNorm(aq26tNeg(u))=aq26tNorm(u)
  . aq26tLe(aq26tNorm(aq26tAdd(u,v)),
             aq26tMax(aq26tNorm(u),aq26tNorm(v)))
  . aq26tDist(u,v)=aq26tNorm(aq26tSub(u,v))
  . aq26tBall(u,v,r) <=> aq26tLe(aq26tDist(u,v),r)
end


