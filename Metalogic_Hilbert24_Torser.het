spec FTRule30Source = FTCoreWords then
  free types FTSite ::= ftNonneg(FTNat) | ftNegSucc(FTNat);
             FTFiniteSeed ::= ftSeed(FTSite; FTWord)
  ops ftLeft, ftRight : FTSite -> FTSite;
      ftOrigin : FTSite;
      ftSingleton : FTFiniteSeed;
      ftInitialCell : FTFiniteSeed * FTSite -> FTBit;
      ftCell : FTFiniteSeed * FTNat * FTSite -> FTBit;
      ftCentre : FTNat -> FTBit;
      ftCentreOnes : FTNat -> FTNat;
      ftOccurrences : FTWord * FTNat -> FTNat
  pred ftMatchesCentre : FTWord * FTNat
  . ftOrigin = ftNonneg(ftZero)
  . ftSingleton = ftSeed(ftOrigin,ftCons(ftBlack,ftEmpty))
  . ftLeft(ftNonneg(ftZero)) = ftNegSucc(ftZero)
  . ftRight(ftNegSucc(ftZero)) = ftNonneg(ftZero)
  . ftCentreOnes(ftZero) = ftZero
  forall a,t : FTNat; j,k : FTSite; z : FTFiniteSeed; e : FTBit; w : FTWord
  . ftLeft(ftNonneg(ftSucc(a))) = ftNonneg(a)
  . ftLeft(ftNegSucc(a)) = ftNegSucc(ftSucc(a))
  . ftRight(ftNonneg(a)) = ftNonneg(ftSucc(a))
  . ftRight(ftNegSucc(ftSucc(a))) = ftNegSucc(a)
  . ftInitialCell(ftSeed(j,ftEmpty),k) = ftWhite
  . ftInitialCell(ftSeed(j,ftCons(e,w)),j) = e
  . not j = k =>
      ftInitialCell(ftSeed(j,ftCons(e,w)),k) = ftInitialCell(ftSeed(ftRight(j),w),k)
  . ftCell(z,ftZero,j) = ftInitialCell(z,j)
  . ftCell(z,ftSucc(t),j) =
      ftXor(ftCell(z,t,ftLeft(j)),ftOr(ftCell(z,t,j),ftCell(z,t,ftRight(j))))
  . ftCentre(t) = ftCell(ftSingleton,t,ftOrigin)
  . ftCentreOnes(ftSucc(t)) = ftAdd(ftCentreOnes(t),ftBitValue(ftCentre(t)))
  . ftMatchesCentre(ftEmpty,t)
  . ftMatchesCentre(ftCons(e,w),t) <=> e = ftCentre(t) /\ ftMatchesCentre(w,ftSucc(t))
  . ftOccurrences(w,ftZero) = ftZero
  . ftMatchesCentre(w,t) => ftOccurrences(w,ftSucc(t)) = ftSucc(ftOccurrences(w,t))
  . not ftMatchesCentre(w,t) => ftOccurrences(w,ftSucc(t)) = ftOccurrences(w,t)
end

