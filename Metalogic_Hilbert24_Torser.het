  preds CNSatisfies : CNCNF * CNAssignment;
        CNSAT,CNUNSAT,CNFixedFibre : CNCNF;
        CNFlippingInput : CNCNF * FTWord
  forall c : CNCNF; z : CNAssignment; x : FTWord
  . cnCircuit(c)=fcCircuit(cnNameCount(cnNames(c)),cnBody(c))
  . cnOracle(c)=fcOracle(cnCircuit(c))
  . cnPrepared(c,x)=fcPrepared(cnCircuit(c),x,ftWhite,ftBlack)
  . cnFlipped(c,x)=fcPrepared(cnCircuit(c),x,ftBlack,ftWhite)
  . cnRun(c,x)=fcRun(cnOracle(c),cnPrepared(c,x))
  . CNSatisfies(c,z) <=> cnFormulaValue(c,z)=ftBlack
  . CNSAT(c) <=> (exists a : CNAssignment . CNSatisfies(c,a))
  . CNUNSAT(c) <=> (forall a : CNAssignment . cnFormulaValue(c,a)=ftWhite)
  . CNFixedFibre(c) <=> (forall w : FTWord .
      ftLength(w)=cnNameCount(cnNames(c)) => cnRun(c,w)=cnPrepared(c,w))
  . CNFlippingInput(c,x) <=> ftLength(x)=cnNameCount(cnNames(c)) /\ cnRun(c,x)=cnFlipped(c,x)
end


