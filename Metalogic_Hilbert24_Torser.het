%% SOURCE H23 BLOCK FTComplexity line 4341
spec FTComplexity = FTMachineRuns then
  sort FTLanguage
  preds ftMember : FTWord * FTLanguage;
        ftPolynomial : FTMachine;
        ftDecides : FTMachine * FTLanguage;
        ftInP, ftInNP, ftInCoNP : FTLanguage
  forall m : FTMachine; a : FTLanguage
  . ftPolynomial(m) <=>
      (exists c,d : FTNat . ftLt(ftZero,c) /\
         (forall x : FTWord .
            ftTimeBound(m,x,ftMul(c,ftPow(ftSucc(ftLength(x)),d)))))
  . ftDecides(m,a) <=> (forall x : FTWord . ftAccepts(m,x) <=> ftMember(x,a))
  . ftInP(a) <=>
      (exists m1 : FTMachine . ftTMDet(m1) /\ ftPolynomial(m1) /\ ftDecides(m1,a))
  . ftInNP(a) <=>
      (exists m1 : FTMachine . ftPolynomial(m1) /\ ftDecides(m1,a))
  . ftInCoNP(a) <=>
      (exists m1 : FTMachine . ftPolynomial(m1) /\
         (forall x : FTWord . ftAccepts(m1,x) <=> not ftMember(x,a)))
end


%% END EMITTED FTComplexity

%% SOURCE H23 BLOCK FTExactSearch line 4383
spec FTExactSearch = FTComplexity then
  sort FTCNF
  ops ftEncodeCNF : FTCNF -> FTWord;
      ftPairWords : FTWord * FTWord -> FTWord;
      ftOutputWord : FTMachine * FTConfig -> FTWord
  preds ftAdmittedAssignment, ftOriginalCNFAccepts : FTCNF * FTWord;
        ftSAT : FTCNF;
        ftWitnessBy : FTMachine * FTWord * FTWord * FTNat;
        ftWitnessFound : FTMachine * FTWord * FTWord;
        ftVerifier : FTMachine
  forall C : FTCNF
  . ftSAT(C) <=>
      (exists x : FTWord . ftAdmittedAssignment(C,x) /\ ftOriginalCNFAccepts(C,x))
  forall m : FTMachine; x,y : FTWord; t : FTNat
  . ftWitnessBy(m,x,y,t) <=>
      (exists k : FTNat; q : FTConfig . ftLe(k,t) /\
          ftExactRun(m,ftTMStart(m,x),k,q) /\ ftTMHalt(m,q) /\
          ftTMAccept(m,q) /\ ftOutputWord(m,q) = y)
  . ftWitnessFound(m,x,y) <=>
      (exists t1 : FTNat . ftWitnessBy(m,x,y,t1))
  . ftVerifier(m) <=> ftTMDet(m) /\ ftPolynomial(m) /\
      (exists c,d : FTNat .
         (forall a,b : FTWord . ftAccepts(m,ftPairWords(a,b)) =>
            ftLe(ftLength(b),ftMul(c,ftPow(ftSucc(ftLength(a)),d)))))
end


