        AYMClock,AYMThreePositive,AYMSpectralRealization,AYMExcitedSectorEmpty : AYMSystem
  forall s : AYMSystem; u : FGeoHilbertVector; e : FGeoReal
  . AYMClock(s) <=> fgLE(fgZero,aymTime(s)) /\ fgLT(fgZero,aymLag(s)) /\
      fgLT(fgZero,aymDelta(s)) /\
      aymCeiling(s)=aymDecay(aymLag(s),aymDelta(s))
      %(aym_physical_clock_and_gap_threshold_are_the_original_scalars)%
  . aymThree(s,u)=fgAdd(fgSub(fgMul(aymCeiling(s),aymC0(s,u)),
      fgMul(fgAdd(fgOne,aymCeiling(s)),aymC1(s,u))),aymC2(s,u))
      %(aym_three_time_form_retains_q_minus_one_plus_q_and_one_coefficients)%
  . aymWeight(s,u)=fgSub(aymC0(s,u),aymC1(s,u))
