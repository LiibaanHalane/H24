%% SOURCE H23 BLOCK FTRule30MachineSource line 4549
spec FTRule30MachineSource = FTPrizeMachineData then
  preds ftComputesCentre, ftCentreLinear, ftCentreSublinear, ftCentreSubpower : FTPrizeMachine
  forall m : FTPrizeMachine
  . ftComputesCentre(m) <=> ftValidMachine(m) /\
      (forall n : FTNat . exists t : FTNat . ftPrizeRun(m,n,t) = ftFinished(ftCentre(n)))
  . ftCentreLinear(m) <=> ftValidMachine(m) /\
      (exists C : FTNat . (forall n : FTNat .
         ftPrizeRun(m,n,ftMul(C,ftSucc(n))) = ftFinished(ftCentre(n))))
  . ftCentreSublinear(m) <=> ftComputesCentre(m) /\
      (forall k : FTNat . exists N : FTNat . (forall n : FTNat . ftLe(N,n) =>
         (exists t : FTNat . ftPrizeRun(m,n,t) = ftFinished(ftCentre(n)) /\
            ftLe(ftMul(k,t),n))))
  . ftCentreSubpower(m) <=> ftComputesCentre(m) /\
      (forall k : FTNat . exists N : FTNat . (forall n : FTNat . ftLe(N,n) =>
         (exists t : FTNat . ftPrizeRun(m,n,t) = ftFinished(ftCentre(n)) /\
            ftLe(ftPow(t,k),n))))
end


