      w : FTWord; e : FTBit; d : SDLDigit; p : SDLCut; v : PFTPlanes; m,n : FTNat
  . shtCut(shtNativeCuts(x),m)=sdlPrefix(x,m)
  . shtWordBit(ftEmpty,m)=ftWhite
