%% SOURCE H23 BLOCK HTPullbackQuantifiers line 8028
spec HTPullbackQuantifiers =
  sorts HTX; HTY; HTYPrime; HTPullback;
        HTPredX; HTPredY; HTPredYPrime; HTPredPullback
  ops htQ : HTX -> HTY;
      htF : HTYPrime -> HTY;
      htPullX : HTPullback -> HTX;
      htPullY : HTPullback -> HTYPrime;
      htMakePullback : HTYPrime * HTX -> HTPullback;
      htExistsQ, htForallQ : HTPredX -> HTPredY;
      htPullF : HTPredY -> HTPredYPrime;
      htPullG : HTPredX -> HTPredPullback;
      htExistsQPrime, htForallQPrime : HTPredPullback -> HTPredYPrime
  preds htHoldsX : HTPredX * HTX;
        htHoldsY : HTPredY * HTY;
        htHoldsYPrime : HTPredYPrime * HTYPrime;
        htHoldsPullback : HTPredPullback * HTPullback
  forall z : HTPullback; x : HTX; y : HTYPrime
  . htF(htPullY(z)) = htQ(htPullX(z)) %(ht_pullback_square)%
  . htF(y)=htQ(x) => htPullY(htMakePullback(y,x))=y %(ht_pullback_first)%
  . htF(y)=htQ(x) => htPullX(htMakePullback(y,x))=x %(ht_pullback_second)%
  . htMakePullback(htPullY(z),htPullX(z))=z %(ht_pullback_pair_uniqueness)%
  forall p : HTPredX; y : HTY
  . htHoldsY(htExistsQ(p),y) <=>
      (exists x : HTX . htQ(x)=y /\ htHoldsX(p,x)) %(ht_exists_q_def)%
  . htHoldsY(htForallQ(p),y) <=>
      (forall x : HTX . htQ(x)=y => htHoldsX(p,x)) %(ht_forall_q_def)%
  forall p : HTPredY; y : HTYPrime
  . htHoldsYPrime(htPullF(p),y) <=> htHoldsY(p,htF(y)) %(ht_pull_f_def)%
  forall p : HTPredX; z : HTPullback
  . htHoldsPullback(htPullG(p),z) <=> htHoldsX(p,htPullX(z)) %(ht_pull_g_def)%
  forall p : HTPredPullback; y : HTYPrime
  . htHoldsYPrime(htExistsQPrime(p),y) <=>
      (exists z : HTPullback . htPullY(z)=y /\ htHoldsPullback(p,z))
        %(ht_exists_qprime_def)%
  . htHoldsYPrime(htForallQPrime(p),y) <=>
      (forall z : HTPullback . htPullY(z)=y => htHoldsPullback(p,z))
        %(ht_forall_qprime_def)%
end


%% END EMITTED HTPullbackQuantifiers

