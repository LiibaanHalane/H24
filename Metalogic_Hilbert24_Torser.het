%% SOURCE H23 BLOCK NRStrongArtinPackets line 18813
spec NRStrongArtinPackets = FANGeneralLDefinitions then
  free etype NRArtinLift ::= nrArtinLift(
    nrArtinSource : FANArtin; nrArtinTarget : FANAutomorphic)
  pred nrArtinLiftCheck : NRArtinLift
  pred NRStrongArtinComplete : ()
  forall p : NRArtinLift
  . nrArtinLiftCheck(p) <=> FANUnitaryCuspidalStandardGL(nrArtinTarget(p)) /\
      fanArtinBase(nrArtinSource(p)) = fanAutomorphicBase(nrArtinTarget(p)) /\
      fanArtinDimension(nrArtinSource(p)) = fanAutomorphicDegree(nrArtinTarget(p)) /\
      FANExactLocalFactorsAndInfinity(nrArtinSource(p),nrArtinTarget(p))
  . NRStrongArtinComplete <=> (forall r : FANArtin . FANIrreducibleFiniteImageArtin(r) =>
      (exists p : NRArtinLift . nrArtinSource(p) = r /\ nrArtinLiftCheck(p)))
end


