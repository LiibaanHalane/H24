      %(aym_positive_physical_gap_gives_a_strict_transfer_ceiling)% %implied
  . aymSpectralPolynomial(s,fgZero)=fgZero
      %(aym_three_time_multiplier_annihilates_the_actual_vacuum_energy)% %implied
  . AYMSpectralRealization(s) => aymThree(s,aymVacuum(s))=fgZero
      %(aym_three_correlation_coefficients_cancel_the_same_normalized_vacuum)% %implied
  . AYMClock(s) /\ fgLT(fgZero,e) /\ fgLT(e,aymDelta(s)) =>
      fgLT(aymSpectralPolynomial(s,e),fgZero)
      %(aym_every_actual_positive_subgap_energy_has_strictly_negative_three_time_sign)% %implied
  . AYMClock(s) /\ fgLE(aymDelta(s),e) =>
      fgLE(fgZero,aymSpectralPolynomial(s,e))
      %(aym_every_actual_above_gap_energy_has_nonnegative_three_time_sign)% %implied
  . AYMClock(s) /\ AYMSpectralRealization(s) =>
      (AYMThreePositive(s) <=> FGeoMassGap(aymHamiltonian(s),aymDelta(s)))
      %(aym_complete_original_word_triangle_iff_mass_gap_of_the_same_physical_H)% %implied
  . AYMClock(s) /\ AYMSpectralRealization(s) /\ AYMThreePositive(s) /\
      FGeoHSpectrum(aymHamiltonian(s),e) =>
      not (fgLT(fgZero,e) /\ fgLT(e,aymDelta(s)))
      %(aym_positive_triangle_excludes_every_original_subgap_spectral_point)% %implied
end

