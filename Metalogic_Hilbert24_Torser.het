  . ftLength(x)=fcArity(c) =>
      (fcEval(fcBody(c),x)=ftWhite <=>
        fcRun(fcOracle(c),fcPrepared(c,x,ftWhite,ftBlack))=
          fcPrepared(c,x,ftWhite,ftBlack))
      %(cj_original_negative_value_and_same_fredkin_whole_return_are_one_condition)% %implied
  . ftLength(x)=fcArity(c) =>
      (fcEval(fcBody(c),x)=ftBlack <=>
        fcRun(fcOracle(c),fcPrepared(c,x,ftWhite,ftBlack))=
          fcPrepared(c,x,ftBlack,ftWhite))
      %(cj_original_positive_value_and_same_fredkin_output_swap_are_one_condition)% %implied
  . cjZeroSource(c) <=> cjFixedFredkinFibre(c)
      %(cj_complete_circuit_refutation_iff_whole_initialized_fredkin_fibre_fixed)% %implied
  . cjNonzeroSource(c) <=> cjFlippedFredkinFibre(c)
      %(cj_same_original_satisfying_input_witnesses_the_fredkin_fibre_flip)% %implied
  . cjZeroSource(c) <=> not cjNonzeroSource(c)
      %(cj_complete_universal_refutation_retains_the_original_complement)% %implied
end
