  . nrR30RunCheck(p) <=>
      ftPrizeRun(nrRRunMachine(p),nrRRunInput(p),nrRRunTime(p)) =
        ftFinished(ftCentre(nrRRunInput(p)))
  forall p : NRR30Tail
  . nrR30SublinearTailCheck(p) <=>
      (forall n : FTNat . ftLe(nrRTailThreshold(p),n) =>
