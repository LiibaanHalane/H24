%% SOURCE H23 BLOCK FTMachineRuns line 4313
spec FTMachineRuns = FTCoreWords then
  sorts FTMachine, FTConfig
  op ftTMStart : FTMachine * FTWord -> FTConfig
  preds ftTMDet : FTMachine;
        ftTMStep : FTMachine * FTConfig * FTConfig;
        ftTMHalt, ftTMAccept : FTMachine * FTConfig;
        ftExactRun : FTMachine * FTConfig * FTNat * FTConfig;
        ftTimeBound : FTMachine * FTWord * FTNat;
        ftAccepts : FTMachine * FTWord
  forall m : FTMachine; c,d : FTConfig; t : FTNat; w : FTWord
  . ftTMDet(m) <=>
      (forall x,y,z : FTConfig . ftTMStep(m,x,y) /\ ftTMStep(m,x,z) => y = z)
  . ftTMHalt(m,c) <=> not (exists q : FTConfig . ftTMStep(m,c,q))
  . ftExactRun(m,c,ftZero,d) <=> c = d
  . ftExactRun(m,c,ftSucc(t),d) <=>
      (exists q : FTConfig . ftTMStep(m,c,q) /\ ftExactRun(m,q,t,d))
  . ftTimeBound(m,w,t) <=>
      (forall q : FTConfig . ftExactRun(m,ftTMStart(m,w),t,q) => ftTMHalt(m,q))
  . ftAccepts(m,w) <=>
      (exists k : FTNat; q : FTConfig .
         ftExactRun(m,ftTMStart(m,w),k,q) /\ ftTMHalt(m,q) /\ ftTMAccept(m,q))
end

