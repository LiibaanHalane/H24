  ops fcApply : FCGate * FTWord -> FTWord;
      fcJoin : FCCode * FCCode -> FCCode;
      fcReverse : FCCode -> FCCode;
      fcRun : FCCode * FTWord -> FTWord;
      fcCount : FCCode -> FTNat
  preds fcDisjoint : FCGate;
        fcWithin : FCGate * FTNat;
        fcCodeWithin : FCCode * FTNat
  forall g : FCGate; p,q : FCCode; x : FTWord; n : FTNat
  . fcDisjoint(g) <=> not fcControl(g)=fcLeft(g) /\
      not fcControl(g)=fcRight(g) /\ not fcLeft(g)=fcRight(g)
  . fcWithin(g,n) <=> fcDisjoint(g) /\ ftLt(fcControl(g),n) /\
      ftLt(fcLeft(g),n) /\ ftLt(fcRight(g),n)
  . fcWithin(g,ftLength(x)) => fcApply(g,x)=
      fcSet(fcSet(x,fcLeft(g),fkSelect(fcGet(x,fcControl(g)),
        fcGet(x,fcLeft(g)),fcGet(x,fcRight(g)))),
        fcRight(g),fkSelect(fcGet(x,fcControl(g)),fcGet(x,fcRight(g)),fcGet(x,fcLeft(g))))
  . not fcWithin(g,ftLength(x)) => fcApply(g,x)=x
  . fcJoin(fcNoGates,q)=q
  . fcJoin(fcNext(g,p),q)=fcNext(g,fcJoin(p,q))
  . fcReverse(fcNoGates)=fcNoGates
  . fcReverse(fcNext(g,p))=fcJoin(fcReverse(p),fcNext(g,fcNoGates))
  . fcRun(fcNoGates,x)=x
  . fcRun(fcNext(g,p),x)=fcRun(p,fcApply(g,x))
  . fcCount(fcNoGates)=ftZero
  . fcCount(fcNext(g,p))=ftSucc(fcCount(p))
  . fcCodeWithin(fcNoGates,n)
