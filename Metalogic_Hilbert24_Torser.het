spec HCFChargeData = HCNativeMinimumReturns and HVICalibrationReturns then
  op hcfScore : Charge -> FGeoReal
  forall a,b : Charge
  . hcfScore(zero)=fgZero
  . hcfScore(plus(a,b))=fgAdd(hcfScore(a),hcfScore(b))
  . hcfScore(minus(a))=aymNeg(hcfScore(a))
  . nonnegative(a) <=> fgLE(fgZero,hcfScore(a))
end


