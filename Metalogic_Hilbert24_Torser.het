%% SOURCE H23 BLOCK NRRiemannProbes line 18396
spec NRRiemannProbes = AnalyticZetaData then
  free etype NRZetaProbe ::= nrZetaProbe(nrZetaPoint : AFComplex)
  preds nrOriginalZetaZero, nrZetaLine, nrZetaCounterexample : NRZetaProbe;
        NRRiemannComplete, NRRiemannCounterexampleExists : ()
  forall p : NRZetaProbe
  . nrOriginalZetaZero(p) <=> afNontrivialZetaZero(nrZetaPoint(p))
  . nrZetaLine(p) <=> afRe(nrZetaPoint(p)) = afHalf
  . nrZetaCounterexample(p) <=> nrOriginalZetaZero(p) /\ not nrZetaLine(p)
  . NRRiemannComplete <=>
      (forall p : NRZetaProbe . nrOriginalZetaZero(p) => nrZetaLine(p))
  . NRRiemannCounterexampleExists <=> (exists p : NRZetaProbe . nrZetaCounterexample(p))
end


