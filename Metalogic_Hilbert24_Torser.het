  . hpNonnegative(a) /\ hpNonnegative(b) => hpNonnegative(hpPlus(a,b))
  . hpNonnegative(a) /\ hpNonnegative(b) /\ hpPlus(a,b)=hpZero =>
      a=hpZero /\ b=hpZero
end


