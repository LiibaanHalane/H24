  forall a,b,c,t : FGeoReal
  . fgAdd(fgAdd(a,b),c)=fgAdd(a,fgAdd(b,c))
  . fgAdd(a,b)=fgAdd(b,a)
  . fgAdd(a,fgZero)=a
  . aymNeg(a)=fgSub(fgZero,a)
  . fgAdd(a,aymNeg(a))=fgZero
  . fgSub(a,b)=fgAdd(a,aymNeg(b))
  . fgMul(fgMul(a,b),c)=fgMul(a,fgMul(b,c))
  . fgMul(a,b)=fgMul(b,a)
  . fgMul(a,fgOne)=a
  . fgMul(a,fgAdd(b,c))=fgAdd(fgMul(a,b),fgMul(a,c))
