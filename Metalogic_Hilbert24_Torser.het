%% SOURCE H23 BLOCK FCWireEnvironmentData line 32075
spec FCWireEnvironmentData = FCSafeCircuitData then
  free type FCWireEnvironment ::= fcNoWires | fcWire(FTNat;FCWireEnvironment)
  ops fcWireAt : FCWireEnvironment * FTNat -> FTNat;
      fcWireLength : FCWireEnvironment -> FTNat;
      fcInputWires : FTNat * FTNat -> FCWireEnvironment;
      fcCompile : FCProgram * FCWireEnvironment * FTNat -> FCCode;
      fcOutputWire : FCProgram * FCWireEnvironment * FTNat -> FTNat
  preds fcEnvironmentBelow : FCWireEnvironment * FTNat;
        fcEnvironmentModels : FCWireEnvironment * FTWord * FTWord
  forall i,j,n,k : FTNat; e : FCWireEnvironment; p : FCProgram;
         u : FCUnary; b : FTBit; x,v : FTWord
  . fcWireAt(fcNoWires,i)=ftZero
  . fcWireAt(fcWire(j,e),ftZero)=j
  . fcWireAt(fcWire(j,e),ftSucc(i))=fcWireAt(e,i)
  . fcWireLength(fcNoWires)=ftZero
  . fcWireLength(fcWire(i,e))=ftSucc(fcWireLength(e))
  . fcInputWires(ftZero,k)=fcNoWires
  . fcInputWires(ftSucc(n),k)=fcWire(k,fcInputWires(n,ftAdd(k,ftTwo)))
  . fcEnvironmentBelow(fcNoWires,n)
  . fcEnvironmentBelow(fcWire(i,e),n) <=> ftLt(i,n) /\ fcEnvironmentBelow(e,n)
  . fcEnvironmentModels(e,x,v) <=> fcWireLength(e)=ftLength(v) /\
      (forall i0 : FTNat . ftLt(i0,ftLength(v)) => fcGet(x,fcWireAt(e,i0))=fcGet(v,i0))
  . fcCompile(fcOutput(i),e,n)=fcNoGates
  . fcCompile(fcUnary(u,i,p),e,n)=fcNext(fcGate(fcWireAt(e,i),n,ftSucc(n)),
      fcCompile(p,fcWire(n,e),ftAdd(n,ftTwo)))
  . fcCompile(fcAnd(i,j,p),e,n)=
      fcNext(fcGate(fcWireAt(e,i),n,ftSucc(n)),
        fcNext(fcGate(fcWireAt(e,j),ftAdd(n,ftTwo),n),
          fcNext(fcGate(ftAdd(n,ftTwo),ftAdd(n,fcThree),ftAdd(n,ftAdd(ftTwo,ftTwo))),
            fcCompile(p,fcWire(ftAdd(n,fcThree),e),ftAdd(n,fcFive)))))
  . fcCompile(fcConstant(b,p),e,n)=fcCompile(p,fcWire(n,e),ftAdd(n,ftTwo))
  . fcOutputWire(fcOutput(i),e,n)=fcWireAt(e,i)
  . fcOutputWire(fcUnary(u,i,p),e,n)=fcOutputWire(p,fcWire(n,e),ftAdd(n,ftTwo))
  . fcOutputWire(fcAnd(i,j,p),e,n)=fcOutputWire(p,fcWire(ftAdd(n,fcThree),e),ftAdd(n,fcFive))
  . fcOutputWire(fcConstant(b,p),e,n)=fcOutputWire(p,fcWire(n,e),ftAdd(n,ftTwo))
end


