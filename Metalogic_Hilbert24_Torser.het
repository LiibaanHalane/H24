%% SOURCE H23 BLOCK FCIndexedGateReturns line 31987
spec FCIndexedGateReturns = FCIndexedGateData then
  forall g : FCGate; p,q : FCCode; x : FTWord
  . ftLength(fcApply(g,x))=ftLength(x)
      %(fc_every_indexed_gate_retains_register_length)% %implied
  . fcApply(g,fcApply(g,x))=x
      %(fc_every_actual_indexed_fredkin_placement_is_an_involution)% %implied
  . fcWeight(fcApply(g,x))=fcWeight(x)
      %(fc_indexed_fredkin_conserves_actual_total_hamming_weight)% %implied
  . fcRun(fcJoin(p,q),x)=fcRun(q,fcRun(p,x))
      %(fc_general_indexed_words_compose_in_execution_order)% %implied
  . fcReverse(fcReverse(p))=p
      %(fc_general_circuit_dagger_squares_to_identity)% %implied
  . fcRun(fcReverse(p),fcRun(p,x))=x /\ fcRun(p,fcRun(fcReverse(p),x))=x
      %(fc_all_finite_circuits_have_both_whole_register_returns)% %implied
  . ftLength(fcRun(p,x))=ftLength(x) /\ fcWeight(fcRun(p,x))=fcWeight(x)
      %(fc_all_finite_circuits_retain_length_and_total_weight)% %implied
  . fcCount(fcJoin(p,q))=ftAdd(fcCount(p),fcCount(q)) /\ fcCount(fcReverse(p))=fcCount(p)
      %(fc_full_forward_reverse_gate_account)% %implied
end

