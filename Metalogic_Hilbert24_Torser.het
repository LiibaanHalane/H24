spec HFPRouteData = FrameEverySourceReturns then
  free type HFPPath ::= hfpId(FPStack) | hfpEdge(FPStack;FPStack) |
      hfpThen(HFPPath;HFPPath)
  ops hfpSource,hfpTarget : HFPPath -> FPStack;
      hfpReverse,hfpNormal : HFPPath -> HFPPath;
      hfpRun : HFPPath * FPView -> FPView
  preds HFPWellFormed : HFPPath;
        HFPComposable,HFPParallel : HFPPath * HFPPath
  forall f,g : FPStack; p,q : HFPPath; z : FPView
  . hfpSource(hfpId(f))=f /\ hfpTarget(hfpId(f))=f
  . hfpSource(hfpEdge(f,g))=f /\ hfpTarget(hfpEdge(f,g))=g
  . hfpSource(hfpThen(p,q))=hfpSource(p)
  . hfpTarget(hfpThen(p,q))=hfpTarget(q)
  . HFPWellFormed(hfpId(f)) /\ HFPWellFormed(hfpEdge(f,g))
  . HFPComposable(p,q) <=> HFPWellFormed(p) /\ HFPWellFormed(q) /\
      hfpTarget(p)=hfpSource(q)
  . HFPWellFormed(hfpThen(p,q)) <=> HFPComposable(p,q)
  . HFPParallel(p,q) <=> HFPWellFormed(p) /\ HFPWellFormed(q) /\
      hfpSource(p)=hfpSource(q) /\ hfpTarget(p)=hfpTarget(q)
  . hfpReverse(hfpId(f))=hfpId(f)
  . hfpReverse(hfpEdge(f,g))=hfpEdge(g,f)
  . hfpReverse(hfpThen(p,q))=hfpThen(hfpReverse(q),hfpReverse(p))
  . hfpNormal(p)=hfpEdge(hfpSource(p),hfpTarget(p))
  . hfpRun(hfpId(f),z)=z
  . hfpRun(hfpEdge(f,g),z)=fpChangeFrame(f,g,fpWholeContext,z)
      %(hfp_each_edge_is_the_actual_original_full_state_rechart)%
  . hfpRun(hfpThen(p,q),z)=hfpRun(q,hfpRun(p,z))
      %(hfp_route_execution_retains_the_original_order_of_composition)%
end


