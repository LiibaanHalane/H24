spec HPStarRing = FTCoreWords then
  sort HPS
  ops hpZero,hpOne : HPS;
      hpPlus,hpTimes : HPS * HPS -> HPS;
      hpNeg,hpStar : HPS -> HPS;
      hpMinus : HPS * HPS -> HPS;
      hpNorm : HPS -> HPS;
      hpPowerTwo : FTNat -> HPS
  . not hpZero = hpOne
  . hpPowerTwo(ftZero)=hpOne
  forall x,y,z : HPS; n : FTNat
  . hpPlus(hpPlus(x,y),z)=hpPlus(x,hpPlus(y,z))
  . hpPlus(x,y)=hpPlus(y,x)
  . hpPlus(hpZero,x)=x
  . hpPlus(x,hpNeg(x))=hpZero
  . hpTimes(hpTimes(x,y),z)=hpTimes(x,hpTimes(y,z))
  . hpTimes(x,y)=hpTimes(y,x)
  . hpTimes(hpOne,x)=x
  . hpTimes(x,hpPlus(y,z))=hpPlus(hpTimes(x,y),hpTimes(x,z))
  . hpStar(hpStar(x))=x
  . hpStar(hpPlus(x,y))=hpPlus(hpStar(x),hpStar(y))
  . hpStar(hpTimes(x,y))=hpTimes(hpStar(x),hpStar(y))
  . hpStar(hpOne)=hpOne
  . hpMinus(x,y)=hpPlus(x,hpNeg(y))
  . hpNorm(x)=hpTimes(hpStar(x),x)
  . hpPowerTwo(ftSucc(n))=hpPlus(hpPowerTwo(n),hpPowerTwo(n))
end


