%% SOURCE H23 BLOCK FGeoYMData line 5704
spec FGeoYMData = FGeoArithmetic then
  esorts FGeoGaugeGroup; FGeoQFT; FGeoHilbert; FGeoHilbertVector; FGeoHamiltonian
  ops fgQFTGroup : FGeoQFT -> FGeoGaugeGroup;
      fgQFTHilbert : FGeoQFT -> FGeoHilbert;
      fgVectorSpace : FGeoHilbertVector -> FGeoHilbert;
      fgHamiltonianSpace : FGeoHamiltonian -> FGeoHilbert;
      fgHilbertZero : FGeoHilbert -> FGeoHilbertVector;
      fgHApply : FGeoHamiltonian * FGeoHilbertVector ->? FGeoHilbertVector
  preds FGeoCompactSimple : FGeoGaugeGroup;
        FGeoYMNontrivialR4, FGeoClayAxiomStrength, FGeoPoincareQFTCovariance,
        FGeoCurvatureObservableCorrespondence, FGeoAsymptoticFreedom,
        FGeoStressTensor, FGeoOperatorProductExpansion : FGeoQFT;
        FGeoSelfAdjoint : FGeoHamiltonian;
        FGeoPhysicalTimeGenerator : FGeoQFT * FGeoHamiltonian;
        FGeoUniqueUnitVacuum : FGeoQFT * FGeoHilbertVector;
        FGeoHSpectrum, FGeoMassGap : FGeoHamiltonian * FGeoReal;
        FGeoFiniteMass, FGeoPositiveSpectrum : FGeoHamiltonian;
        FGeoYMExists, FGeoYMExistsAndGap : ()
  %% FGeoClayAxiomStrength asks for proofs at least as strong as the
  %% Wightman and Osterwalder-Schader schemes cited by the original text.
  %% An equivalent reconstruction may supply those proofs on one QFT.
  %% FGeoHSpectrum is the spectrum of that operator with its actual domain.
  %% FGeoUniqueUnitVacuum(t,v) chooses a unit representative v of
  %% the unique Poincare-invariant vacuum ray, so uniqueness is up to phase.
  forall h : FGeoHamiltonian
  . FGeoPositiveSpectrum(h) <=>
      (forall e : FGeoReal . FGeoHSpectrum(h,e) => fgLE(fgZero,e))
      %(fgeo_ym_positive_energy_spectrum)%
  . FGeoFiniteMass(h) <=> (exists m : FGeoReal . fgLT(fgZero,m) /\
      (forall d : FGeoReal . FGeoMassGap(h,d) => fgLE(d,m)))
      %(fgeo_ym_finite_supremal_mass)%
  forall h : FGeoHamiltonian; d : FGeoReal
  . FGeoMassGap(h,d) <=> fgLT(fgZero,d) /\
      (forall e : FGeoReal . FGeoHSpectrum(h,e) =>
        not (fgLT(fgZero,e) /\ fgLT(e,d)))
      %(fgeo_ym_actual_hamiltonian_gap)%
end


%% END EMITTED FGeoYMData

%% SOURCE H23 BLOCK FGeoYMAcceptance line 5742
spec FGeoYMAcceptance = FGeoYMData then
  pred FGeoYMConstruction : FGeoGaugeGroup * FGeoQFT * FGeoHamiltonian * FGeoHilbertVector
  forall g : FGeoGaugeGroup; t : FGeoQFT; h : FGeoHamiltonian; v : FGeoHilbertVector
  . FGeoYMConstruction(g,t,h,v) <=>
      fgQFTGroup(t) = g /\ FGeoYMNontrivialR4(t) /\ FGeoClayAxiomStrength(t) /\
      FGeoPoincareQFTCovariance(t) /\ FGeoCurvatureObservableCorrespondence(t) /\
      FGeoAsymptoticFreedom(t) /\ FGeoStressTensor(t) /\ FGeoOperatorProductExpansion(t) /\
      FGeoPhysicalTimeGenerator(t,h) /\ FGeoSelfAdjoint(h) /\
      fgHamiltonianSpace(h) = fgQFTHilbert(t) /\ fgVectorSpace(v) = fgQFTHilbert(t) /\
      FGeoUniqueUnitVacuum(t,v) /\
      fgHApply(h,v) = fgHilbertZero(fgQFTHilbert(t)) /\
      FGeoPositiveSpectrum(h)
      %(fgeo_ym_typed_nontrivial_continuum_existence)%
  . FGeoYMExists <=> (forall g : FGeoGaugeGroup . FGeoCompactSimple(g) =>
      (exists t : FGeoQFT; h : FGeoHamiltonian; v : FGeoHilbertVector .
        FGeoYMConstruction(g,t,h,v)))
      %(fgeo_ym_existence_only_definition)%
  . FGeoYMExistsAndGap <=> (forall g : FGeoGaugeGroup . FGeoCompactSimple(g) =>
      (exists t : FGeoQFT; h : FGeoHamiltonian; v : FGeoHilbertVector; d : FGeoReal .
        FGeoYMConstruction(g,t,h,v) /\ FGeoMassGap(h,d) /\ FGeoFiniteMass(h)))
      %(fgeo_ym_existence_same_system_positive_finite_mass_definition)%
end


