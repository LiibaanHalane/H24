      gsuDot,gsuPair : GSUVector4 * GSUVector4 -> SemR;
      gsuToFrame,gsuFromFrame : GSUFrame * GSUVector4 -> GSUVector4;
      gsuChange : GSUFrame * GSUFrame * GSUVector4 -> GSUVector4;
