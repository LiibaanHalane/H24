spec FANGeneralLDefinitions = FANZetaDefinitions then
  sorts FANCharacter, FANAutomorphic, FANArtin
  ops fanDirichletXi : FANCharacter * FANComplex -> FANComplex;
      fanDedekindXi : FANField * FANComplex -> FANComplex;
      fanAutomorphicXi : FANAutomorphic * FANComplex -> FANComplex;
      fanDirichletLift : FANCharacter -> FANAutomorphic;
      fanPrincipalPrimitiveCharacter : FANCharacter;
      fanArtinBase : FANArtin -> FANField;
      fanAutomorphicBase : FANAutomorphic -> FANField;
      fanArtinDimension : FANArtin -> FANNat;
      fanAutomorphicDegree : FANAutomorphic -> FANNat
  preds FANPrimitiveDirichlet : FANCharacter;
        FANUnitaryCuspidalStandardGL : FANAutomorphic;
        FANIrreducibleFiniteImageArtin, FANNontrivialArtin : FANArtin;
        FANArtinLIsEntire : FANArtin;
        FANCompletedArtinZero : FANArtin * FANComplex;
        FANExactLocalFactorsAndInfinity : FANArtin * FANAutomorphic;
        FANDirichletLine : FANCharacter;
        FANDedekindLine : FANField;
        FANAutomorphicLine : FANAutomorphic;
        FANArtinLine : FANArtin;
        FANDirichletGRH, FANDedekindGRH, FANAutomorphicGRH,
        FANArtinGRH, FANArtinHolomorphy, FANStrongArtin : ()
  %% The Xi functions keep the complete original nontrivial zero divisor,
  %% including multiplicities and all ramified factors. Genuine poles
  %% are removed with their exact orders. GL_d is in unitary normalization
  %% with critical line Re(s)=1/2, over the marked number field.
  forall c : FANCharacter; k : FANField; a : FANAutomorphic; r : FANArtin
  . FANDirichletLine(c) <=>
      (forall z : FANComplex . fanDirichletXi(c,z) = fanComplexZero =>
          fanRealPart(z) = fanHalf)
    %(fan_dirichlet_line_definition)%
  . FANDedekindLine(k) <=>
      (forall z : FANComplex . fanDedekindXi(k,z) = fanComplexZero =>
          fanRealPart(z) = fanHalf)
    %(fan_dedekind_line_definition)%
  . FANAutomorphicLine(a) <=>
      (forall z : FANComplex . fanAutomorphicXi(a,z) = fanComplexZero =>
          fanRealPart(z) = fanHalf)
    %(fan_automorphic_line_definition)%
  . FANArtinLine(r) <=>
      (forall z : FANComplex . FANCompletedArtinZero(r,z) =>
          fanRealPart(z) = fanHalf)
    %(fan_artin_line_definition)%
