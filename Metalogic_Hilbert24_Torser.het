          nrRRunInput(r) = n /\ nrR30RunCheck(r) /\
          ftLe(ftMul(nrRTailAccuracy(p),nrRRunTime(r)),n)))
  . nrR30SubpowerTailCheck(p) <=>
      (forall n : FTNat . ftLe(nrRTailThreshold(p),n) =>
