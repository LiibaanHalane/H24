%% SOURCE H23 BLOCK NRYangMillsPackets line 18302
spec NRYangMillsPackets = FGeoYMAcceptance then
  free etype NRYangMillsPacket ::= nrYangMillsPacket(
    nrYGroup : FGeoGaugeGroup; nrYTheory : FGeoQFT;
    nrYHamiltonian : FGeoHamiltonian; nrYVacuum : FGeoHilbertVector;
    nrYGap : FGeoReal; nrYMassBound : FGeoReal)
  preds nrYangMillsCheck : NRYangMillsPacket; NRYangMillsComplete : ()
  forall p : NRYangMillsPacket
  . nrYangMillsCheck(p) <=>
      FGeoYMConstruction(nrYGroup(p),nrYTheory(p),nrYHamiltonian(p),nrYVacuum(p)) /\
      fgLT(fgZero,nrYGap(p)) /\
      (forall e : FGeoReal . FGeoHSpectrum(nrYHamiltonian(p),e) =>
        not (fgLT(fgZero,e) /\ fgLT(e,nrYGap(p)))) /\
      fgLT(fgZero,nrYMassBound(p)) /\
      (forall d : FGeoReal . FGeoMassGap(nrYHamiltonian(p),d) => fgLE(d,nrYMassBound(p)))
      %(nr_ym_same_continuum_system_and_spectral_check)%
  . NRYangMillsComplete <=> (forall g : FGeoGaugeGroup . FGeoCompactSimple(g) =>
      (exists p : NRYangMillsPacket . nrYGroup(p) = g /\ nrYangMillsCheck(p)))
end


