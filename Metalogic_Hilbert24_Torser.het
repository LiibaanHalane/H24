%% SOURCE H23 BLOCK AFBSDArithmeticData line 5178
spec AFBSDArithmeticData = AFBSDPlaces then
  sorts AFBEllipticTorsorClass; AFBShaEnumeration
  ops afbEmbedNat : AFNat -> AFBComplex;
      afbEmbedReal : AFBReal -> AFBComplex;
      afbShaAtIndex : AFBShaEnumeration * AFNat -> AFBEllipticTorsorClass
  preds AFBEllipticTorsorClassAt : AFBCurve * AFBEllipticTorsorClass;
        AFBTorsorHasLocalPointAt : AFBEllipticTorsorClass * AFBPlace;
        AFBShaClassAt : AFBCurve * AFBEllipticTorsorClass;
        AFBArithmeticTorsionCardinality : AFBCurve * AFNat;
        AFBShaFiniteCardinality : AFBCurve * AFNat;
        AFBRegulatorAt : AFBCurve * AFBReal;
        AFBPositiveDiscriminantRoot : AFBField * AFBReal;
        AFBLeadingCoefficientFormulaAt : AFBCurve * AFBComplex
  forall e : AFBCurve; b : AFBEllipticTorsorClass; n : AFNat
  . AFBShaClassAt(e,b) <=>
      AFBEllipticTorsorClassAt(e,b)  /\ (forall v : AFBPlace . AFBPlaceOf(afbField(e),v) => AFBTorsorHasLocalPointAt(b,v))
      %(afb_sha_local_triviality_definition)%
  . AFBShaFiniteCardinality(e,n) <=>
      (exists s : AFBShaEnumeration .
        (forall i : AFNat . afAtLeast(n,afSucc(i)) => AFBShaClassAt(e,afbShaAtIndex(s,i)))  /\ (forall u : AFBEllipticTorsorClass . AFBShaClassAt(e,u) =>
           (exists j : AFNat . afAtLeast(n,afSucc(j)) /\ afbShaAtIndex(s,j) = u))  /\ (forall i,j : AFNat .
          afAtLeast(n,afSucc(i)) /\ afAtLeast(n,afSucc(j))  /\ afbShaAtIndex(s,i) = afbShaAtIndex(s,j) => i = j))
      %(afb_sha_finite_bijection_definition)%
  forall e : AFBCurve; a : AFBComplex
  . AFBLeadingCoefficientFormulaAt(e,a) <=>
      (exists omega : AFBDifferential; t,h : AFNat; g,v,d : AFBReal .
        AFBNonzeroInvariantDifferentialAt(e,omega) /\
        AFBArithmeticTorsionCardinality(e,t) /\ not t = afZero /\
        AFBShaFiniteCardinality(e,h) /\ AFBRegulatorAt(e,g) /\
        AFBArchimedeanAndFiniteVolumeAt(e,omega,v) /\
        AFBPositiveDiscriminantRoot(afbField(e),d) /\
        afbMultiply(afbMultiply(a,afbEmbedNat(t)),
                    afbMultiply(afbEmbedNat(t),afbEmbedReal(d))) =
        afbMultiply(afbEmbedNat(h),afbMultiply(afbEmbedReal(g),afbEmbedReal(v))))
      %(afb_refined_formula_cleared_denominators)%
  %% AFBShaFiniteCardinality(e,h) means actual finite Sha, with h its
  %% cardinality, not a computed analytic proxy. The regulator is the
  %% determinant on a Z-basis of E(K)/torsion (empty determinant 1).
  %% Write V(E/K,omega) for AFBArchimedeanAndFiniteVolumeAt:
  %% product of real integrals of |omega| over E(K_v), complex
  %% integrals of |omega wedge conjugate(omega)| over E(K_v), and
  %% all finite factors c_v * |omega/omega_v^min|_v. The absolute
  %% values are those for the product formula on K. The complex
  %% density |omega wedge conjugate(omega)| has the factor 2.
  %% Thus d=sqrt(|disc K|) and the formula is
  %% a * (#tors)^2 * sqrt(|disc K|) = #Sha * Reg * V(E/K,omega).
  %% Over Q the global Neron differential makes all finite scaling
  %% factors 1 and d=1, recovering Omega_R times product c_p.
end


%% END EMITTED AFBSDArithmeticData

%% SOURCE H23 BLOCK AFBSDAbelianData line 5427
spec AFBSDAbelianData = AFBSDArithmeticData then
  sorts AFBAbelian; AFBFunctionField; AFBFunctionFieldAbelian; AFBVariable
  ops afbAbelianBase : AFBAbelian -> AFBField;
      afbDual : AFBAbelian -> AFBAbelian;
      afbFFBase : AFBFunctionFieldAbelian -> AFBFunctionField;
      afbInverseConstantFieldSize : AFBFunctionField -> AFBVariable
  preds AFBAbelianVariety : AFBAbelian;
        AFBAbelianRankAt, AFBAbelianTorsionOrder, AFBAbelianFiniteShaOrder : AFBAbelian * AFNat;
        AFBAbelianFullContinuation : AFBAbelian * AFBFunction;
        AFBAbelianRegulator, AFBAbelianVolume, AFBAbelianDiscriminantFactor : AFBAbelian * AFBReal;
        AFBAbelianLeadingFormula : AFBAbelian * AFBComplex;
        AFBGlobalFunctionField : AFBFunctionField;
        AFBAbelianOverFunctionField : AFBFunctionFieldAbelian;
        AFBFFRankAt, AFBFFFiniteShaOrder : AFBFunctionFieldAbelian * AFNat;
        AFBFFHasseWeilOrderAt : AFBFunctionFieldAbelian * AFBVariable * AFNat

  %% FullContinuation is actual holomorphic continuation of the
  %% Euler product on the right half-plane, in the weight-one
  %% convention whose central value is s=1. HasseWeilOrderAt is
  %% the actual local vanishing order of the rational function in
  %% T with Euler factors using T^deg(v), not a rank proxy.
  %% FiniteShaOrder always means cardinality of the locally trivial
  %% torsor class group of the indicated object.
  forall a : AFBAbelian; c : AFBComplex
  . AFBAbelianLeadingFormula(a,c) <=>
      (exists t,u,h : AFNat; g,v,d : AFBReal .
        AFBAbelianTorsionOrder(a,t) /\ AFBAbelianTorsionOrder(afbDual(a),u) /\
        not t = afZero /\ not u = afZero /\
        AFBAbelianFiniteShaOrder(a,h) /\ AFBAbelianRegulator(a,g) /\
        AFBAbelianVolume(a,v) /\ AFBAbelianDiscriminantFactor(a,d) /\
        afbMultiply(afbMultiply(c,afbEmbedNat(t)),
                    afbMultiply(afbEmbedNat(u),afbEmbedReal(d))) =
        afbMultiply(afbEmbedNat(h),afbMultiply(afbEmbedReal(g),afbEmbedReal(v))))
      %(afb_generalized_abelian_leading_coefficient_formula)%
end


%% END EMITTED AFBSDAbelianData

%% SOURCE H23 BLOCK NRAbelianBSDPackets line 18628
spec NRAbelianBSDPackets = AFBSDAbelianData then
  free etype NRAbelianBSDRank ::= nrAbelianBSDRank(
    nrABVariety : AFBAbelian; nrABFunction : AFBFunction;
    nrABRank : AFNat; nrABLeading : AFBComplex)
  free etype NRAbelianBSDLeading ::= nrAbelianBSDLeading(
    nrALVariety : AFBAbelian; nrALFunction : AFBFunction;
    nrALRank : AFNat; nrALLeading : AFBComplex;
    nrALTorsion : AFNat; nrALDualTorsion : AFNat; nrALSha : AFNat;
    nrALRegulator : AFBReal; nrALVolume : AFBReal; nrALDiscriminant : AFBReal)
  free etype NRFunctionFieldBSD ::= nrFunctionFieldBSD(
    nrFFVariety : AFBFunctionFieldAbelian; nrFFRank : AFNat; nrFFSha : AFNat)
  preds nrAbelianRankCheck : NRAbelianBSDRank;
        nrAbelianLeadingCheck : NRAbelianBSDLeading;
        nrFunctionFieldBSDCheck : NRFunctionFieldBSD;
        NRAbelianBSDRankComplete, NRAbelianBSDRefinedComplete,
        NRFunctionFieldBSDComplete : ()
  forall p : NRAbelianBSDRank
  . nrAbelianRankCheck(p) <=>
      AFBAbelianFullContinuation(nrABVariety(p),nrABFunction(p)) /\
      AFBAbelianRankAt(nrABVariety(p),nrABRank(p)) /\
      AFBTaylorLeadingTermAt(nrABFunction(p),nrABRank(p),nrABLeading(p))
  forall p : NRAbelianBSDLeading
  . nrAbelianLeadingCheck(p) <=>
      AFBAbelianFullContinuation(nrALVariety(p),nrALFunction(p)) /\
      AFBAbelianRankAt(nrALVariety(p),nrALRank(p)) /\
      AFBTaylorLeadingTermAt(nrALFunction(p),nrALRank(p),nrALLeading(p)) /\
      AFBAbelianTorsionOrder(nrALVariety(p),nrALTorsion(p)) /\
      AFBAbelianTorsionOrder(afbDual(nrALVariety(p)),nrALDualTorsion(p)) /\
      not nrALTorsion(p) = afZero /\ not nrALDualTorsion(p) = afZero /\
      AFBAbelianFiniteShaOrder(nrALVariety(p),nrALSha(p)) /\
      AFBAbelianRegulator(nrALVariety(p),nrALRegulator(p)) /\
      AFBAbelianVolume(nrALVariety(p),nrALVolume(p)) /\
      AFBAbelianDiscriminantFactor(nrALVariety(p),nrALDiscriminant(p)) /\
      afbMultiply(afbMultiply(nrALLeading(p),afbEmbedNat(nrALTorsion(p))),
        afbMultiply(afbEmbedNat(nrALDualTorsion(p)),afbEmbedReal(nrALDiscriminant(p)))) =
      afbMultiply(afbEmbedNat(nrALSha(p)),
        afbMultiply(afbEmbedReal(nrALRegulator(p)),afbEmbedReal(nrALVolume(p))))
  forall p : NRFunctionFieldBSD
  . nrFunctionFieldBSDCheck(p) <=>
      AFBFFRankAt(nrFFVariety(p),nrFFRank(p)) /\
      AFBFFFiniteShaOrder(nrFFVariety(p),nrFFSha(p)) /\
      AFBFFHasseWeilOrderAt(nrFFVariety(p),
        afbInverseConstantFieldSize(afbFFBase(nrFFVariety(p))),nrFFRank(p))
  . NRAbelianBSDRankComplete <=> (forall a : AFBAbelian .
      AFBAbelianVariety(a) /\ AFBNumberField(afbAbelianBase(a)) =>
      (exists p : NRAbelianBSDRank . nrABVariety(p) = a /\ nrAbelianRankCheck(p)))
  . NRAbelianBSDRefinedComplete <=> (forall a : AFBAbelian .
      AFBAbelianVariety(a) /\ AFBNumberField(afbAbelianBase(a)) =>
      (exists p : NRAbelianBSDLeading . nrALVariety(p) = a /\ nrAbelianLeadingCheck(p)))
  . NRFunctionFieldBSDComplete <=> (forall a : AFBFunctionFieldAbelian .
      AFBAbelianOverFunctionField(a) /\ AFBGlobalFunctionField(afbFFBase(a)) =>
      (exists p : NRFunctionFieldBSD . nrFFVariety(p) = a /\ nrFunctionFieldBSDCheck(p)))
end


