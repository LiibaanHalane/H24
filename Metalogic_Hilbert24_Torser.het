  . gsuDot(x,y)=gsuSum4(semRMul(gsuV1(x),gsuV1(y)),semRMul(gsuV2(x),gsuV2(y)),
      semRMul(gsuV3(x),gsuV3(y)),semRMul(gsuV4(x),gsuV4(y)))
