%% SOURCE H23 BLOCK CNWordNameData line 32698
spec CNWordNameData = CJFredkinFibreReturns then
  free types CNNames ::= cnNoNames | cnName(FTWord;CNNames);
             CNAssignment ::= cnNoAssignment | cnBind(FTWord;FTBit;CNAssignment)
  ops cnWordEqual : FTWord * FTWord -> FTBit;
      cnContains : FTWord * CNNames -> FTBit;
      cnInsert : FTWord * CNNames -> CNNames;
      cnNameCount : CNNames -> FTNat;
      cnNameAt : CNNames * FTNat -> FTWord;
      cnNameIndex : FTWord * CNNames -> FTNat;
      cnLookup : CNAssignment * FTWord -> FTBit;
      cnRestrict : CNNames * CNAssignment -> FTWord;
      cnExpand : CNNames * FTWord -> CNAssignment
  preds CNMember : FTWord * CNNames; CNUnique : CNNames
  forall a,b : FTBit; u,v : FTWord; d : CNNames; k : FTNat; z : CNAssignment
  . cnWordEqual(ftEmpty,ftEmpty)=ftBlack
  . cnWordEqual(ftEmpty,ftCons(b,v))=ftWhite
  . cnWordEqual(ftCons(a,u),ftEmpty)=ftWhite
  . cnWordEqual(ftCons(a,u),ftCons(b,v))=
      ftAnd(ftFlip(ftXor(a,b)),cnWordEqual(u,v))
  . cnContains(u,cnNoNames)=ftWhite
  . cnContains(u,cnName(v,d))=ftOr(cnWordEqual(u,v),cnContains(u,d))
  . cnContains(u,d)=ftBlack => cnInsert(u,d)=d
  . cnContains(u,d)=ftWhite => cnInsert(u,d)=cnName(u,d)
  . cnNameCount(cnNoNames)=ftZero
  . cnNameCount(cnName(u,d))=ftSucc(cnNameCount(d))
  . cnNameAt(cnNoNames,k)=ftEmpty
  . cnNameAt(cnName(u,d),ftZero)=u
  . cnNameAt(cnName(u,d),ftSucc(k))=cnNameAt(d,k)
