      fgAssembleJoint(cnJointExecution(w)))
  . cnfgSourceProjection(j)=cnJoint(cnfgSource(j),cnfgAssignment(j),
      fgExecution(cnfgReturn(j)))
  . cnfgConstruct(c,a)=cnfgExtend(cnConstructJoint(c,a))
  . cnfgConstructDense(c,x)=cnfgConstruct(c,cnAssignmentFor(c,x))
