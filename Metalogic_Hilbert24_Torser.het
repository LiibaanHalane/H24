      ftExecute(ftTableAt(tab,ftAdd(ftMul(p,ftSucc(ftSymbolBound(s))),ftTapeRead(tape,x))),tape,x)
  . ftPrizeRun(m,n,ftZero) =
      ftRunning(ftZero,ftOrigin,ftLoad(ftBinaryLSB(n),ftOrigin))
  . ftPrizeRun(m,n,ftSucc(t)) = ftTick(m,ftPrizeRun(m,n,t))
end

