  preds ftValidAction : FTPrizeAction * FTNat * FTNat;
        ftValidMachine : FTPrizeMachine
  . ftTableLength(ftTableEmpty) = ftZero
  forall q,s,p,a,k,n,t : FTNat; e : FTBit; d : FTMove; x,y : FTSite;
         tab : FTPrizeTable; act : FTPrizeAction; tape : FTPrizeTape;
         m : FTPrizeMachine; w : FTWord
  . ftSymbolBound(s) = ftAdd(s,ftTwo)
  . ftTableLength(ftTableCons(act,tab)) = ftSucc(ftTableLength(tab))
  . ftTableAt(ftTableEmpty,k) = ftStop(ftWhite)
  . ftTableAt(ftTableCons(act,tab),ftZero) = act
  . ftTableAt(ftTableCons(act,tab),ftSucc(k)) = ftTableAt(tab,k)
  . ftValidAction(ftStop(e),q,s)
  . ftValidAction(ftAdvance(p,a,d),q,s) <=> ftLe(p,q) /\ ftLe(a,ftSymbolBound(s))
  . ftValidMachine(ftMachine(q,s,tab)) <=>
      ftTableLength(tab) = ftMul(ftSucc(q),ftSucc(ftSymbolBound(s))) /\
      (forall i,j : FTNat . ftLe(i,q) /\ ftLe(j,ftSymbolBound(s)) =>
        ftValidAction(ftTableAt(tab,ftAdd(ftMul(i,ftSucc(ftSymbolBound(s))),j)),q,s))
  . ftTapeRead(ftBlankTape,x) = ftZero
  . ftTapeRead(ftWritten(x,a,tape),x) = a
  . not x = y => ftTapeRead(ftWritten(x,a,tape),y) = ftTapeRead(tape,y)
  . ftLoad(ftEmpty,x) = ftBlankTape
  . ftLoad(ftCons(e,w),x) =
