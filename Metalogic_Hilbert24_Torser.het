spec GSUChangeChartData = GSUAdjointReturns then
  free type GSUChart ::= gsuChart(gsuBasis:SemMatrix4;gsuBasisInverse:SemMatrix4)
  ops gsuChartInverse : GSUChart -> GSUChart;
