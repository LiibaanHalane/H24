spec FGOperatorData = FGFibreReturns then
  ops fgProject,fgB,fgBdagger,fgGramOperator : FCSafeCircuit * FGSum -> FGSum
  preds FGZeroGram,FGZeroOperator : FCSafeCircuit
  forall c : FCSafeCircuit; a : FGSum; z : EGInt; w : FTWord
  . fgProject(c,fgNil)=fgNil
  . FGInitial(c,w) => fgProject(c,fgTerm(z,w,a))=fgTerm(z,w,fgProject(c,a))
  . not FGInitial(c,w) => fgProject(c,fgTerm(z,w,a))=fgProject(c,a)
  . fgB(c,a)=fgSub(fgAct(fcOracle(c),fgProject(c,a)),fgProject(c,a))
  . fgBdagger(c,a)=fgProject(c,fgSub(fgAct(fcOracle(c),a),a))
  . fgGramOperator(c,a)=fgBdagger(c,fgB(c,a))
  . FGZeroGram(c) <=>
      (forall x : FTWord . ftLength(x)=fcArity(c) => fgGram(c,x,x)=fgZero)
  . FGZeroOperator(c) <=> (forall v : FGSum . FGEqual(fgB(c,v),fgNil))
end


