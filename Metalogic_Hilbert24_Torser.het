%% SOURCE H23 BLOCK MQSumData line 27589
spec MQSumData = HTPullbackQuantifiers then
  sort MQEvidence
  preds mqPositive,mqOpposing : HTX * MQEvidence
  free types MQDirect ::= mqDirect(mqBase:HTYPrime;mqSource:HTX;mqEvidence:MQEvidence);
             MQPulled ::= mqPulled(mqPullPoint:HTPullback;mqPullEvidence:MQEvidence)
  ops mqSigmaTo : MQDirect -> MQPulled;
      mqSigmaFrom : MQPulled -> MQDirect
  preds mqCompatible,mqDirectPositive,mqDirectOpposing : MQDirect;
        mqPulledPositive,mqPulledOpposing : MQPulled
  forall y : HTYPrime; x : HTX; e : MQEvidence; z : HTPullback;
         a : MQDirect; b : MQPulled
  . a=mqDirect(mqBase(a),mqSource(a),mqEvidence(a))
      %(mq_direct_record_reconstruction)%
  . b=mqPulled(mqPullPoint(b),mqPullEvidence(b))
      %(mq_pulled_record_reconstruction)%
  . mqCompatible(mqDirect(y,x,e)) <=> htF(y)=htQ(x)
  . mqSigmaTo(mqDirect(y,x,e))=mqPulled(htMakePullback(y,x),e)
  . mqSigmaFrom(mqPulled(z,e))=mqDirect(htPullY(z),htPullX(z),e)
  . mqDirectPositive(a) <=> mqCompatible(a) /\ mqPositive(mqSource(a),mqEvidence(a))
  . mqDirectOpposing(a) <=> mqCompatible(a) /\ mqOpposing(mqSource(a),mqEvidence(a))
  . mqPulledPositive(b) <=> mqPositive(htPullX(mqPullPoint(b)),mqPullEvidence(b))
  . mqPulledOpposing(b) <=> mqOpposing(htPullX(mqPullPoint(b)),mqPullEvidence(b))
end


