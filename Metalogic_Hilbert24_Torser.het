      semNativeProduct(m24EncodeAlgebra(x),m24EncodeAlgebra(y))
      %(m24_group_convolution_and_native_matrix_product_are_the_same_actual_algebra)% %implied
  . m24EncodeAlgebra(m24GroupStar(x))=semNativeDagger(m24EncodeAlgebra(x))
      %(m24_actual_group_inverse_involution_is_the_original_native_Gram_dagger)% %implied
end

